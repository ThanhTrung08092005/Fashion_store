        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Khách hàng\\n(Customers)\&quot; as Customer\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\n\nusecase \&quot;\\n2.1\\nCập nhật Hồ sơ\\nCá nhân\\n\&quot; as P21\nusecase \&quot;\\n2.2\\nCập nhật Sở thích\\nThời trang\\n\&quot; as P22\nusecase \&quot;\\n2.3\\nCập nhật &amp; Xóa mềm\\nKhách hàng\\n\&quot; as P23\nusecase \&quot;\\n2.4\\nTra cứu &amp; Lọc\\nKhách hàng\\n\&quot; as P24\n\ncard \&quot;D1.1 | TAIKHOAN\&quot; as D_TK\ncard \&quot;D2.1 | KHACHHANG\&quot; as D_KH\ncard \&quot;D2.2 | KHACHHANG_SOTHICH\&quot; as D_KHST\ncard \&quot;D3.1 | DANHMUC\&quot; as D_DM\n\n&#39; 2.1 Cập nhật hồ sơ cá nhân\nCustomer --&gt; P21 : Hồ sơ cá nhân mới\nD_KH --&gt; P21 : Hồ sơ hiện tại\nP21 --&gt; D_KH : Thông tin cá nhân\\n&amp; địa chỉ cập nhật\nP21 --&gt; Customer : Hồ sơ đã cập nhật\n\n&#39; 2.2 Cập nhật sở thích thời trang\nCustomer --&gt; P22 : Sở thích thời trang chọn\nD_DM --&gt; P22 : Danh mục thời trang\nP22 --&gt; D_KHST : Danh mục sở thích\\ncủa khách hàng\nD_KHST --&gt; P22 : Sở thích hiện tại\n\n&#39; 2.3 Cập nhật &amp; xóa mềm khách hàng\nManager --&gt; P23 : Hồ sơ khách hàng\\ncập nhật\nP23 --&gt; D_TK : Tài khoản mới &amp;\\ntrạng thái khóa\nP23 --&gt; D_KH : Hồ sơ khách hàng\\n&amp; cờ xóa mềm\nP23 --&gt; D_KHST : Sở thích khách hàng\n\n&#39; 2.4 Tra cứu &amp; lọc khách hàng\nManager --&gt; P24 : Tiêu chí tìm kiếm\\n&amp; lọc khách hàng\nD_KH --&gt; P24 : Dữ liệu hồ sơ\\nkhách hàng\nD_KHST --&gt; P24 : Dữ liệu sở thích\nD_TK --&gt; P24 : Trạng thái tài khoản\nP24 --&gt; Manager : Danh sách khách hàng\\n&amp; sở thích\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-198">
          <mxCell connectable="0" parent="9KREx-GiOw8d7Ruz8HDg-104" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
