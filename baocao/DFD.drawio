        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\nrectangle \&quot;Khách hàng\\n(Customers)\&quot; as Customer\n\nusecase \&quot;\\n3.1\\nCập nhật Danh mục\\nSản phẩm\\n\&quot; as P31\nusecase \&quot;\\n3.2\\nCập nhật Sản phẩm\\n&amp; Biến thể\\n\&quot; as P32\nusecase \&quot;\\n3.3\\nTra cứu &amp; Lọc\\nSản phẩm\\n\&quot; as P33\n\ncard \&quot;D3.1 | DANHMUC\&quot; as D_DM\ncard \&quot;D3.2 | SANPHAM\&quot; as D_SP\ncard \&quot;D3.3 | SOLUONGSP\&quot; as D_SL\n\n&#39; 3.1 Cập nhật danh mục sản phẩm\nManager --&gt; P31 : Thông tin danh mục\nP31 --&gt; D_DM : Danh mục mới &amp;\\ntrạng thái hiển thị\nD_DM --&gt; P31 : Danh sách danh mục\nP31 --&gt; Manager : Danh sách danh mục\\nsản phẩm\n\n&#39; 3.2 Cập nhật sản phẩm &amp; biến thể\nManager --&gt; P32 : Thông tin sản phẩm\\n&amp; biến thể (Size, Màu, Giá, Tồn)\nD_DM --&gt; P32 : Thông tin danh mục\nP32 --&gt; D_SP : Thông tin sản phẩm\\ncập nhật\nP32 --&gt; D_SL : Biến thể SKU, giá bán\\n&amp; số lượng tồn kho\nD_SL --&gt; P32 : Dữ liệu tồn kho\\nhiện tại\n\n&#39; 3.3 Tra cứu &amp; lọc sản phẩm\nCustomer --&gt; P33 : Tiêu chí tìm kiếm\\n&amp; lọc sản phẩm\nD_DM --&gt; P33 : Tên danh mục\nD_SP --&gt; P33 : Thông tin chi tiết\\nsản phẩm\nD_SL --&gt; P33 : Giá bán, màu sắc,\\nkích thước &amp; tồn kho\nP33 --&gt; Customer : Thông tin sản phẩm\\n&amp; danh mục\nP33 --&gt; Manager : Báo cáo sản phẩm\\n&amp; tồn kho\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-250">
          <mxCell connectable="0" parent="9KREx-GiOw8d7Ruz8HDg-104" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
