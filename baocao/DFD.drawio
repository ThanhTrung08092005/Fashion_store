        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\n\nusecase \&quot;\\n6.1\\nThống kê Cơ cấu\\nĐộ tuổi KH\\n\&quot; as P61\nusecase \&quot;\\n6.2\\nPhân tích Xu hướng\\nSở thích\\n\&quot; as P62\nusecase \&quot;\\n6.3\\nTổng hợp Kết quả\\nKhảo sát\\n\&quot; as P63\nusecase \&quot;\\n6.4\\nTổng hợp Mức độ\\nHài lòng KH\\n\&quot; as P64\n\ncard \&quot;D2.1 | KHACHHANG\&quot; as D_KH\ncard \&quot;D2.2 | KHACHHANG_SOTHICH\&quot; as D_KHST\ncard \&quot;D3.1 | DANHMUC\&quot; as D_DM\ncard \&quot;D4.1 | PHANHOI\&quot; as D_PH\ncard \&quot;D4.2 | DANHGIA\&quot; as D_DG\ncard \&quot;D5.1 | KHAOSAT\&quot; as D_KS\ncard \&quot;D5.2 | CAUHOI_KHAOSAT\&quot; as D_CH\ncard \&quot;D5.3 | LUACHON_CAUHOI\&quot; as D_LC\ncard \&quot;D5.4 | PHIEUKHAOSAT\&quot; as D_PKS\ncard \&quot;D5.5 | TRALOI_KHAOSAT\&quot; as D_TL\n\n&#39; 6.1 Thống kê cơ cấu độ tuổi KH\nD_KH --&gt; P61 : Ngày sinh khách hàng\\nđang hoạt động\nP61 --&gt; Manager : Báo cáo tỷ lệ\\nnhóm độ tuổi\n\n&#39; 6.2 Phân tích xu hướng sở thích\nD_KH --&gt; P62 : Hồ sơ khách hàng\nD_KHST --&gt; P62 : Lượt chọn sở thích\nD_DM --&gt; P62 : Tên danh mục thời trang\nP62 --&gt; Manager : Báo cáo xu hướng\\nsở thích thời trang\n\n&#39; 6.3 Tổng hợp kết quả khảo sát\nD_KS --&gt; P63 : Thông tin chiến dịch\nD_CH --&gt; P63 : Danh sách câu hỏi\nD_LC --&gt; P63 : Danh sách phương án\nD_PKS --&gt; P63 : Phiếu đã hoàn thành\nD_TL --&gt; P63 : Dữ liệu câu trả lời\nP63 --&gt; Manager : Báo cáo phân tích\\nkhảo sát &amp; file Excel\n\n&#39; 6.4 Tổng hợp mức độ hài lòng KH\nD_PH --&gt; P64 : Điểm sao &amp; trạng thái\\nxử lý phản hồi\nD_DG --&gt; P64 : Điểm sao đánh giá\\nsản phẩm\nP64 --&gt; Manager : Báo cáo mức độ\\nhài lòng khách hàng\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-368">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
