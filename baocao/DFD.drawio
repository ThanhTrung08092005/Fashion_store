        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Khách hàng\\n(Customers)\&quot; as Customer\nrectangle \&quot;Quản trị viên\\n(Admin)\&quot; as Admin\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\n\nusecase \&quot;\\n1.1\\nĐăng ký\\nTài khoản KH\\n\&quot; as P11\nusecase \&quot;\\n1.2\\nXác thực\\nĐăng nhập\\n\&quot; as P12\nusecase \&quot;\\n1.3\\nQuản lý Tài khoản\\n&amp; Phân quyền\\n\&quot; as P13\nusecase \&quot;\\n1.4\\nĐổi Mật khẩu\\n\&quot; as P14\n\ncard \&quot;D1.1 | TAIKHOAN\&quot; as D_TK\ncard \&quot;D1.2 | VAITRO\&quot; as D_VT\ncard \&quot;D1.3 | QUANLY\&quot; as D_QL\ncard \&quot;D2.1 | KHACHHANG\&quot; as D_KH\ncard \&quot;D2.2 | KHACHHANG_SOTHICH\&quot; as D_KHST\ncard \&quot;D3.1 | DANHMUC\&quot; as D_DM\n\n&#39; 1.1 Đăng ký tài khoản khách hàng\nCustomer --&gt; P11 : Thông tin đăng ký\\n&amp; sở thích chọn\nD_VT --&gt; P11 : Vai trò khách hàng\nD_DM --&gt; P11 : Danh mục hợp lệ\nP11 --&gt; D_TK : Tài khoản khách hàng mới\nP11 --&gt; D_KH : Hồ sơ khách hàng mới\nP11 --&gt; D_KHST : Sở thích ban đầu\n\n&#39; 1.2 Xác thực đăng nhập\nCustomer --&gt; P12 : Thông tin đăng nhập KH\nManager --&gt; P12 : Thông tin đăng nhập nội bộ\nD_TK --&gt; P12 : Thông tin tài khoản\\n&amp; mật khẩu băm\nD_VT --&gt; P12 : Thông tin vai trò\nD_QL --&gt; P12 : Hồ sơ &amp; chức vụ quản lý\nP12 --&gt; Customer : Thông tin xác thực\\ntài khoản (JWT)\nP12 --&gt; Manager : Phiên đăng nhập\\nquản trị (Cookie)\n\n&#39; 1.3 Quản lý tài khoản &amp; phân quyền\nAdmin --&gt; P13 : Thông tin tài khoản\\n&amp; phân quyền mới\nAdmin --&gt; P13 : Yêu cầu khóa / mở\\ntài khoản\nD_VT --&gt; P13 : Danh sách vai trò\nP13 --&gt; D_TK : Tài khoản &amp; trạng thái\\ncập nhật\nP13 --&gt; D_QL : Hồ sơ nhân sự quản lý\nD_TK --&gt; P13 : Danh sách tài khoản\nP13 --&gt; Admin : Danh sách tài khoản\\n&amp; vai trò\n\n&#39; 1.4 Đổi mật khẩu\nCustomer --&gt; P14 : Mật khẩu cũ &amp; mới\nD_TK --&gt; P14 : Mật khẩu hiện tại\nP14 --&gt; D_TK : Mật khẩu mới đã băm\nP14 --&gt; Customer : Kết quả đổi mật khẩu\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-160">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
