        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Khách hàng\\n(Customers)\&quot; as Customer\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\n\nusecase \&quot;\\n4.1\\nTiếp nhận Phản hồi\\nKhách hàng\\n\&quot; as P41\nusecase \&quot;\\n4.2\\nGhi nhận Đánh giá\\nSản phẩm\\n\&quot; as P42\nusecase \&quot;\\n4.3\\nPhân loại &amp; Tra cứu\\nPhản hồi\\n\&quot; as P43\nusecase \&quot;\\n4.4\\nPhúc đáp Phản hồi\\nKhách hàng\\n\&quot; as P44\n\ncard \&quot;D1.3 | QUANLY\&quot; as D_QL\ncard \&quot;D2.1 | KHACHHANG\&quot; as D_KH\ncard \&quot;D3.2 | SANPHAM\&quot; as D_SP\ncard \&quot;D4.1 | PHANHOI\&quot; as D_PH\ncard \&quot;D4.2 | DANHGIA\&quot; as D_DG\n\n&#39; 4.1 Tiếp nhận phản hồi khách hàng\nCustomer --&gt; P41 : Nội dung phản hồi\\n&amp; khiếu nại\nD_KH --&gt; P41 : Thông tin khách hàng\nD_SP --&gt; P41 : Thông tin sản phẩm\nP41 --&gt; D_PH : Bản ghi phản hồi mới\n\n&#39; 4.2 Ghi nhận đánh giá sản phẩm\nCustomer --&gt; P42 : Điểm sao &amp; nhận xét\\nsản phẩm\nD_KH --&gt; P42 : Thông tin khách hàng\nD_SP --&gt; P42 : Thông tin sản phẩm\nP42 --&gt; D_DG : Bản ghi đánh giá sao\n\n&#39; 4.3 Phân loại &amp; tra cứu phản hồi\nD_PH --&gt; P43 : Danh sách phản hồi\\nchưa xử lý\nD_DG --&gt; P43 : Dữ liệu đánh giá\\nsản phẩm\nD_KH --&gt; P43 : Họ tên khách hàng\nD_SP --&gt; P43 : Tên sản phẩm\nP43 --&gt; Manager : Danh sách phản hồi\\n&amp; đánh giá\n\n&#39; 4.4 Phúc đáp phản hồi khách hàng\nManager --&gt; P44 : Nội dung phúc đáp\\nphản hồi\nD_QL --&gt; P44 : Thông tin người quản lý\nD_PH --&gt; P44 : Phản hồi cần xử lý\nP44 --&gt; D_PH : Nội dung phúc đáp &amp;\\ntrạng thái Đã xử lý\nP44 --&gt; Customer : Kết quả phúc đáp\\nphản hồi\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-274">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
