        <mxCell id="9KREx-GiOw8d7Ruz8HDg-65" parent="9KREx-GiOw8d7Ruz8HDg-42" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;span style=&quot;font-family: &amp;quot;Segoe UI&amp;quot;; font-size: 11px; text-align: right; white-space: nowrap; background-color: rgb(255, 255, 255);&quot;&gt;Hồ sơ nhân sự quản lý&lt;/span&gt;" vertex="1">
