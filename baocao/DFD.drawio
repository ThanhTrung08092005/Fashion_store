        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Arial\&quot;\nskinparam shadowing false\nskinparam dpi 200\nskinparam splines true\n\nskinparam rectangle {\n    BackgroundColor #ECC0C0\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam usecase {\n    BackgroundColor #FAD089\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 12\n    FontStyle bold\n    FontColor #000000\n}\n\nskinparam card {\n    BackgroundColor #E2F0D9\n    BorderColor #000000\n    BorderThickness 1.2\n    FontSize 11\n    FontStyle bold\n    FontColor #000000\n    RoundCorner 0\n}\n\nskinparam arrow {\n    Color #000000\n    Thickness 1.1\n    FontColor #000000\n    FontSize 10\n}\n\nrectangle \&quot;Người quản lý\\n(Managers)\&quot; as Manager\nrectangle \&quot;Khách hàng\\n(Customers)\&quot; as Customer\n\nusecase \&quot;\\n5.1\\nTạo Chiến dịch\\nKhảo sát\\n\&quot; as P51\nusecase \&quot;\\n5.2\\nThiết lập Bộ câu hỏi\\n&amp; Phương án\\n\&quot; as P52\nusecase \&quot;\\n5.3\\nPhát hành Phiếu\\nKhảo sát\\n\&quot; as P53\nusecase \&quot;\\n5.4\\nGhi nhận Kết quả\\nLàm Khảo sát\\n\&quot; as P54\n\ncard \&quot;D1.3 | QUANLY\&quot; as D_QL\ncard \&quot;D2.1 | KHACHHANG\&quot; as D_KH\ncard \&quot;D5.1 | KHAOSAT\&quot; as D_KS\ncard \&quot;D5.2 | CAUHOI_KHAOSAT\&quot; as D_CH\ncard \&quot;D5.3 | LUACHON_CAUHOI\&quot; as D_LC\ncard \&quot;D5.4 | PHIEUKHAOSAT\&quot; as D_PKS\ncard \&quot;D5.5 | TRALOI_KHAOSAT\&quot; as D_TL\n\n&#39; 5.1 Tạo chiến dịch khảo sát\nManager --&gt; P51 : Thông tin chiến dịch\\nkhảo sát mới\nD_QL --&gt; P51 : Thông tin người quản lý\nP51 --&gt; D_KS : Chiến dịch khảo sát\\n&amp; thời hạn\n\n&#39; 5.2 Thiết lập bộ câu hỏi &amp; phương án\nManager --&gt; P52 : Bộ câu hỏi &amp;\\nphương án lựa chọn\nD_KS --&gt; P52 : Mã chiến dịch khảo sát\nP52 --&gt; D_CH : Danh sách câu hỏi\nP52 --&gt; D_LC : Danh sách phương án\n\n&#39; 5.3 Phát hành phiếu khảo sát\nD_KS --&gt; P53 : Khảo sát đang mở\nD_CH --&gt; P53 : Nội dung câu hỏi\nD_LC --&gt; P53 : Phương án trả lời\nD_KH --&gt; P53 : Danh sách khách hàng\\nhoạt động\nP53 --&gt; D_PKS : Phiếu khảo sát\\n(Trạng thái Đang làm)\nP53 --&gt; Customer : Phiếu khảo sát\\nmẫu mới\n\n&#39; 5.4 Ghi nhận kết quả làm khảo sát\nCustomer --&gt; P54 : Phiếu trả lời\\nkhảo sát\nD_PKS --&gt; P54 : Thông tin phiếu\\ncủa khách hàng\nD_CH --&gt; P54 : Ràng buộc câu hỏi\nD_LC --&gt; P54 : Phương án hợp lệ\nP54 --&gt; D_TL : Chi tiết câu trả lời\nP54 --&gt; D_PKS : Trạng thái Đã hoàn thành\\n&amp; ngày nộp\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9KREx-GiOw8d7Ruz8HDg-304">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
