@model Fashion_store.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Admin System - Fashion_store";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --brand-black: #000000;
            --brand-blue-active: #0099ff;
            --brand-border-gray: #e5e7eb;
            --brand-text-muted: #6b7280;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8fafc;
            color: #111827;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Main Header */
        .main-header {
            padding: 24px 0;
            border-bottom: 1px solid #f3f4f6;
            background: #ffffff;
        }

        .brand-logo {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #000000;
            text-decoration: none;
            line-height: 1;
            white-space: nowrap;
        }

        /* Signin Box - Dành riêng cho Admin */
        .signin-container {
            max-width: 480px;
            margin: 60px auto 80px;
            padding: 40px 36px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid #edf2f7;
        }

        .tab-header {
            display: flex;
            border-bottom: 2px solid #f3f4f6;
            margin-bottom: 30px;
            position: relative;
            justify-content: center;
        }

        .tab-btn {
            text-align: center;
            padding: 12px 0;
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #000000;
            background: none;
            border: none;
            position: relative;
            display: block;
            width: 100%;
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--brand-blue-active);
        }

        .form-floating-custom {
            margin-bottom: 22px;
            position: relative;
        }

        .form-floating-custom input {
            border: none;
            border-bottom: 1px solid #e5e7eb;
            border-radius: 0;
            padding: 11px 0;
            width: 100%;
            font-size: 0.925rem;
            outline: none;
            background: transparent;
            color: #111827;
            transition: border-color 0.2s;
        }

        .form-floating-custom input::placeholder {
            color: #9ca3af;
        }

        .form-floating-custom input:focus {
            border-bottom-color: #000000;
        }

        /* Hiển thị lỗi đồng bộ chuẩn AccountManagement */
        .form-floating-custom input.is-invalid {
            border-bottom-color: #dc2626 !important;
        }

        .invalid-feedback-custom {
            display: none;
            color: #dc2626;
            font-size: 0.775rem;
            font-weight: 500;
            margin-top: 5px;
            box-sizing: border-box;
            text-align: left;
        }

        .invalid-feedback-custom.d-block {
            display: block !important;
        }

        /* Nút Đăng Nhập rộng 100% bằng độ dài Textbox */
        .btn-brand-submit {
            background-color: #000000;
            color: #ffffff;
            font-weight: 800;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 13px 0;
            border: none;
            border-radius: 2px;
            transition: opacity 0.2s, background-color 0.2s;
            display: block;
            width: 100%;
            text-align: center;
        }

        .btn-brand-submit:hover {
            opacity: 0.9;
            background-color: #1e293b;
            color: #ffffff;
        }

        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>

    <!-- Main Header - Căn giữa chữ Fashion_store ADMIN -->
    <header class="main-header text-center">
        <div class="container">
            <a href="/Admin/Account/Login" class="brand-logo d-inline-flex align-items-center justify-content-center gap-2">
                <span>Fashion_store</span>
                <span class="badge bg-dark text-white font-monospace fs-6 px-2.5 py-1 align-middle border ms-1">ADMIN</span>
            </a>
        </div>
    </header>

    <!-- Signin Box - Dành riêng cho Admin (Đã lược bỏ Tab Đăng ký & Quên mật khẩu) -->
    <main class="signin-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show flash-auto-dismiss small p-2 mb-3" role="alert">
                <i class="fa-solid fa-circle-check me-1"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show flash-auto-dismiss small p-2 mb-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Tab Header Đơn (Chỉ giữ lại ĐĂNG NHẬP, gạch chân xanh dương đúng thiết kế Fashion_store) -->
        <div class="tab-header">
            <div class="tab-btn active">
                ĐĂNG NHẬP
            </div>
        </div>

        <!-- Form Đăng Nhập Admin (novalidate chặn popup mặc định của trình duyệt) -->
        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]" autocomplete="off" novalidate id="adminLoginForm">
            @Html.AntiForgeryToken()

            @{
                var generalErrors = ViewData.ModelState[string.Empty]?.Errors
                    .Select(e => e.ErrorMessage)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .Distinct()
                    .ToList();
            }

            @if (generalErrors != null && generalErrors.Any())
            {
                <div class="alert alert-danger p-3 mb-3 border-danger-subtle rounded-2 small fw-semibold">
                    <div class="d-flex align-items-center gap-2 mb-1 text-danger font-weight-bold">
                        <i class="fa-solid fa-circle-exclamation fs-6"></i>
                        <span>Thông báo đăng nhập:</span>
                    </div>
                    <ul class="mb-0 ps-3 text-danger">
                        @foreach (var err in generalErrors)
                        {
                            <li>@err</li>
                        }
                    </ul>
                </div>
            }

            @{
                var uErrors = ViewData.ModelState["TenDangNhap"]?.Errors.Select(e => e.ErrorMessage).FirstOrDefault();
                var pErrors = ViewData.ModelState["MatKhau"]?.Errors.Select(e => e.ErrorMessage).FirstOrDefault();
            }

            <div class="form-floating-custom">
                <input asp-for="TenDangNhap" id="loginTenDangNhap" class="@(!string.IsNullOrEmpty(uErrors) ? "is-invalid" : "")" placeholder="Nhập email hoặc Tên đăng nhập" autocomplete="off" />
                <div class="invalid-feedback-custom @(!string.IsNullOrEmpty(uErrors) ? "d-block" : "")" data-for="TenDangNhap" style="@(!string.IsNullOrEmpty(uErrors) ? "display: block;" : "")">@uErrors</div>
            </div>

            <div class="form-floating-custom mb-4">
                <input asp-for="MatKhau" id="loginMatKhau" type="password" class="@(!string.IsNullOrEmpty(pErrors) ? "is-invalid" : "")" placeholder="Mật khẩu" autocomplete="new-password" />
                <div class="invalid-feedback-custom @(!string.IsNullOrEmpty(pErrors) ? "d-block" : "")" data-for="MatKhau" style="@(!string.IsNullOrEmpty(pErrors) ? "display: block;" : "")">@pErrors</div>
            </div>

            <!-- Nút Submit rộng 100% bằng độ dài Textbox (Lược bỏ liên kết Quên mật khẩu) -->
            <div class="mb-3">
                <button type="submit" class="btn btn-brand-submit" id="btnLoginSubmit">
                    ĐĂNG NHẬP
                </button>
            </div>
        </form>
    </main>

    <!-- Scripts Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ========================================================
        // Quản lý lỗi validation tại từng trường (Đồng bộ AccountManagement)
        // ========================================================
        function getFieldErrorElement(input) {
            if (!input || !input.name) return null;
            const container = input.closest('.form-floating-custom') || input.parentElement;
            let err = container.querySelector(`.invalid-feedback-custom[data-for="${input.name}"]`);
            if (!err) {
                err = document.createElement('div');
                err.className = 'invalid-feedback-custom';
                err.setAttribute('data-for', input.name);
                input.insertAdjacentElement('afterend', err);
            }
            return err;
        }

        function setInputError(input, message) {
            if (!input) return;
            const err = getFieldErrorElement(input);
            if (message) {
                input.classList.add('is-invalid');
                if (err) {
                    err.textContent = message;
                    err.classList.add('d-block');
                    err.style.display = 'block';
                }
            } else {
                input.classList.remove('is-invalid');
                if (err) {
                    err.textContent = '';
                    err.classList.remove('d-block');
                    err.style.display = 'none';
                }
            }
        }

        const loginForm = document.getElementById('adminLoginForm');
        if (loginForm) {
            // Xóa lỗi ngay lập tức khi người dùng nhập dữ liệu vào ô
            loginForm.querySelectorAll('input').forEach(input => {
                input.addEventListener('input', function () {
                    setInputError(this, '');
                });
                input.addEventListener('change', function () {
                    setInputError(this, '');
                });
            });

            // Kiểm tra hiển thị thông báo dưới từng ô khi nhấn nút ĐĂNG NHẬP
            loginForm.addEventListener('submit', function (e) {
                const uInput = document.getElementById('loginTenDangNhap') || loginForm.querySelector('input[name="TenDangNhap"]');
                const pInput = document.getElementById('loginMatKhau') || loginForm.querySelector('input[name="MatKhau"]');

                let isValid = true;
                let firstInvalidInput = null;

                function markInvalid(input, msg) {
                    if (!input) return;
                    setInputError(input, msg);
                    isValid = false;
                    if (!firstInvalidInput) firstInvalidInput = input;
                }

                const uVal = uInput ? uInput.value.trim() : '';
                const pVal = pInput ? pInput.value : '';

                if (!uVal) {
                    markInvalid(uInput, 'Vui lòng nhập email hoặc Tên đăng nhập.');
                } else {
                    setInputError(uInput, '');
                }

                if (!pVal) {
                    markInvalid(pInput, 'Vui lòng nhập mật khẩu.');
                } else {
                    setInputError(pInput, '');
                }

                if (!isValid) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (firstInvalidInput) {
                        firstInvalidInput.focus();
                    }
                    return false;
                }
            });
        }

        // Tự động ẩn thông báo sau 5 giây (nếu có thông báo đăng xuất/thất bại)
        document.querySelectorAll('.flash-auto-dismiss').forEach(alertEl => {
            setTimeout(() => {
                try {
                    const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                    bsAlert.close();
                } catch {
                    alertEl.style.display = 'none';
                }
            }, 5000);
        });
    </script>

    @if (string.Equals(Context.Request.Query["loggedOut"].ToString(), "true", StringComparison.OrdinalIgnoreCase))
    {
        <script>
            const clearAdminLoginFields = () => {
                const username = document.querySelector('input[name="TenDangNhap"]');
                const password = document.querySelector('input[name="MatKhau"]');
                if (username) username.value = '';
                if (password) password.value = '';
            };
            clearAdminLoginFields();
            window.addEventListener('pageshow', clearAdminLoginFields);
            setTimeout(clearAdminLoginFields, 100);
        </script>
    }
</body>
</html>
