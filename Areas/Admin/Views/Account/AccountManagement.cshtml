    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // ==========================================
        // 1. Quản lý Tag Sở thích khách hàng (Thêm / Xóa tag từ danh mục CSDL)
        // ==========================================
        function addTag(prefix) {
            const selectElem = document.getElementById('selectDm_' + prefix);
            if (!selectElem) return;
            const dmId = selectElem.value;
            if (!dmId) return;

            const selectedOption = selectElem.options[selectElem.selectedIndex];
            const dmName = selectedOption.getAttribute('data-name') || selectedOption.text;

            const tagBox = document.getElementById('tagBox_' + prefix);
            if (!tagBox) return;

            // Kiểm tra trùng lặp
            if (tagBox.querySelector(`[data-dm-id="${dmId}"]`)) {
                return;
            }

            // Xóa thông báo rỗng nếu có
            const emptyMsg = tagBox.querySelector('.no-tag-msg');
            if (emptyMsg) {
                emptyMsg.remove();
            }

            // Tạo thẻ Tag badge (Không thể gõ sửa chữ, chỉ thêm/xóa)
            // Tạo thẻ Tag badge tối giản chuẩn Admin
            const tagSpan = document.createElement('span');
            tagSpan.className = 'tag-item-admin';
            tagSpan.setAttribute('data-dm-id', dmId);
            tagSpan.id = `tag_item_${prefix}_${dmId}`;
            tagSpan.innerHTML = `
                <span>${dmName}</span>
                <button type="button" class="btn-remove-tag" onclick="removeTag('${prefix}', ${dmId})" title="Xóa tag">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <input type="hidden" name="SoThichIds" value="${dmId}" />
            `;

            tagBox.appendChild(tagSpan);

            // Disable option trong select để không chọn trùng
            selectedOption.disabled = true;
            selectedOption.text = dmName + ' (Đã thêm)';
            selectElem.selectedIndex = 0;
        }

        function removeTag(prefix, dmId) {
            const tagBox = document.getElementById('tagBox_' + prefix);
            const tagSpan = document.getElementById(`tag_item_${prefix}_${dmId}`) || (tagBox ? tagBox.querySelector(`[data-dm-id="${dmId}"]`) : null);
            if (tagSpan) {
                tagSpan.remove();
            }

            // Mở lại option trong dropdown
            const selectElem = document.getElementById('selectDm_' + prefix);
            if (selectElem) {
                for (let i = 0; i < selectElem.options.length; i++) {
                    if (selectElem.options[i].value == dmId) {
                        const origName = selectElem.options[i].getAttribute('data-name');
                        const isActive = selectElem.options[i].dataset.active === 'true';
                        selectElem.options[i].disabled = !isActive;
                        if (origName) {
                            selectElem.options[i].text = isActive ? origName : origName + ' (Ngừng hoạt động)';
                        }
                        break;
                    }
                }
            }

            // Nếu không còn tag nào, hiển thị lại ghi chú
            if (tagBox && tagBox.querySelectorAll('[data-dm-id]').length === 0) {
                tagBox.innerHTML = '<span class="text-muted small fst-italic no-tag-msg">Chưa có sở thích nào</span>';
            }
        }

        // ==========================================
        // 2. Logic kiểm tra ngày sinh (đồng bộ với register.html)
        // ==========================================
        function checkAgeValidity(inputElem, errorElemId) {
            const errorElem = document.getElementById(errorElemId);
            if (!inputElem.value) {
                if (errorElem) errorElem.style.display = 'none';
                inputElem.setCustomValidity('');
                return true;
            }

            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const parsedBirthDate = new Date(`${inputElem.value}T00:00:00`);

            if (parsedBirthDate > today) {
                const msg = 'Ngày sinh không thể nằm trong tương lai.';
                if (errorElem) {
                    errorElem.textContent = msg;
                    errorElem.style.display = 'block';
                }
                inputElem.setCustomValidity(msg);
                return false;
            } else {
                if (errorElem) errorElem.style.display = 'none';
                inputElem.setCustomValidity('');
                return true;
            }
        }

        // ==========================================
        // 3. Khóa / Mở khóa tài khoản Ajax
        // ==========================================
        function toggleAccountStatus(id, switchElem) {
            const labelElem = document.getElementById('status_text_' + id);
            fetch('/Admin/Account/ToggleStatus/' + id, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.newStatus) {
                        labelElem.textContent = 'Hoạt động';
                        labelElem.className = 'text-success';
                    } else {
                        labelElem.textContent = 'Bị khóa';
                        labelElem.className = 'text-danger';
                    }
                } else {
                    alert(data.message || 'Thao tác thất bại.');
                    switchElem.checked = !switchElem.checked;
                }
            })
            .catch(err => {
                alert('Lỗi kết nối máy chủ.');
                switchElem.checked = !switchElem.checked;
            });
        }

        // ==========================================
        // 4. Ẩn / Hiện mật khẩu & Khởi tạo mật khẩu mặc định
        // ==========================================
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                if (icon) {
                    icon.classList.remove('fa-eye');
                    icon.classList.add('fa-eye-slash');
                }
            } else {
                input.type = 'password';
                if (icon) {
                    icon.classList.remove('fa-eye-slash');
                    icon.classList.add('fa-eye');
                }
            }
        }

        // ==========================================
        // 5. Quản lý lỗi validation tại từng trường (Không reload, Không reset form)
        // ==========================================
        function getFieldErrorElement(input) {
            if (!input || !input.name) return null;
            const fieldContainer = input.closest('.mb-3, .col-6, .col-12, .form-group') || input.parentElement;
            let err = fieldContainer.querySelector(`.invalid-feedback-custom[data-for="${input.name}"]`);
            if (!err) {
                const group = input.closest('.input-group') || input;
                err = document.createElement('div');
                err.className = 'invalid-feedback-custom';
                err.setAttribute('data-for', input.name);
                group.insertAdjacentElement('afterend', err);
            }
            return err;
        }

        function setInputError(input, message) {
            if (!input) return;
            const err = getFieldErrorElement(input);
            if (message) {
                input.classList.add('is-invalid');
                if (err) {
                    err.textContent = message;
                    err.style.display = 'block';
                }
            } else {
                input.classList.remove('is-invalid');
                if (err) {
                    err.textContent = '';
                    err.style.display = 'none';
                }
            }
        }

        function clearFormErrors(form) {
            if (!form) return;
            form.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            form.querySelectorAll('.invalid-feedback-custom').forEach(el => {
                el.textContent = '';
                el.style.display = 'none';
            });
            form.querySelectorAll('[id^="dob_error_"]').forEach(el => {
                el.textContent = '';
                el.style.display = 'none';
            });
            const alertBox = form.querySelector('.form-alert-modal');
            if (alertBox) {
                alertBox.textContent = '';
                alertBox.style.display = 'none';
            }
        }

        function isValidEmail(email) {
            if (!email || email.length > 100 || /\s/.test(email)) return false;
            const parts = email.split('@@');
            if (parts.length !== 2 || !parts[0] || !parts[1]) return false;
            const domainParts = parts[1].split('.');
            if (domainParts.length < 2) return false;
            return domainParts.every(p => p.length > 0);
        }

        function validateAccountForm(form) {
            let isValid = true;
            let firstInvalidInput = null;

            function markInvalid(input, msg) {
                if (!input) return;
                setInputError(input, msg);
                isValid = false;
                if (!firstInvalidInput) firstInvalidInput = input;
            }

            // 1. Tên Đăng Nhập (Create forms)
            const uInput = form.querySelector('input[name="TenDangNhap"]:not([readonly])');
            if (uInput) {
                const val = uInput.value.trim();
                if (!val) {
                    markInvalid(uInput, 'Tên đăng nhập không được để trống.');
                } else if (val.length < 4 || val.length > 50) {
                    markInvalid(uInput, 'Tên đăng nhập phải có từ 4 đến 50 ký tự.');
                } else if (/\s/.test(val)) {
                    markInvalid(uInput, 'Tên đăng nhập không được chứa khoảng trắng.');
                } else {
                    setInputError(uInput, '');
                }
            }

            // 2. Họ và Tên
            const nameInput = form.querySelector('input[name="HoTen"]');
            if (nameInput) {
                const val = nameInput.value.trim();
                if (!val) {
                    markInvalid(nameInput, 'Họ và tên không được để trống.');
                } else if (val.length > 100) {
                    markInvalid(nameInput, 'Họ và tên không được vượt quá 100 ký tự.');
                } else {
                    setInputError(nameInput, '');
                }
            }

            // 3. Email
            const emailInput = form.querySelector('input[name="Email"]');
            if (emailInput) {
                const val = emailInput.value.trim();
                if (!val) {
                    markInvalid(emailInput, 'Email không được để trống.');
                } else if (!isValidEmail(val) || val.length > 100) {
                    markInvalid(emailInput, 'Email không đúng định dạng.');
                } else {
                    setInputError(emailInput, '');
                }
            }

            // 4. Số Điện Thoại (Bắt buộc cho cả khách hàng và nhân sự)
            const phoneInput = form.querySelector('input[name="SoDienThoai"]');
            if (phoneInput) {
                const val = phoneInput.value.trim();
                if (!val) {
                    markInvalid(phoneInput, 'Số điện thoại không được để trống.');
                } else if (!/^\d+$/.test(val) || val.length > 15) {
                    markInvalid(phoneInput, 'Số điện thoại không đúng định dạng.');
                } else {
                    setInputError(phoneInput, '');
                }
            }

            // 5. Ngày Sinh (Bắt buộc không được để trống)
            const dobInput = form.querySelector('input[name="NgaySinh"]');
            if (dobInput) {
                const val = dobInput.value ? dobInput.value.trim() : '';
                if (!val) {
                    markInvalid(dobInput, 'Ngày sinh không được để trống.');
                } else {
                    const today = new Date();
                    today.setHours(0, 0, 0, 0);
                    const parsedDate = new Date(`${val}T00:00:00`);
                    if (parsedDate > today) {
                        markInvalid(dobInput, 'Ngày sinh không thể nằm trong tương lai.');
                    } else {
                        setInputError(dobInput, '');
                    }
                }
            }

            // 6. Giới tính (Bắt buộc không được để trống)
            const genderInput = form.querySelector('select[name="GioiTinh"]');
            if (genderInput && !genderInput.closest('[style*="display:none"]')) {
                const val = genderInput.value ? genderInput.value.trim() : '';
                if (!val) {
                    markInvalid(genderInput, 'Vui lòng chọn giới tính.');
                } else {
                    setInputError(genderInput, '');
                }
            }

            // 7. Địa chỉ (Bắt buộc không được để trống nếu có trường Địa chỉ)
            const addrInput = form.querySelector('input[name="DiaChi"]');
            if (addrInput) {
                const val = addrInput.value ? addrInput.value.trim() : '';
                if (!val) {
                    markInvalid(addrInput, 'Địa chỉ không được để trống.');
                } else if (val.length > 255) {
                    markInvalid(addrInput, 'Địa chỉ không được vượt quá 255 ký tự.');
                } else {
                    setInputError(addrInput, '');
                }
            }

            // 8. Chức vụ (Bắt buộc không được để trống nếu có trường Chức vụ)
            const chucVuInput = form.querySelector('select[name="ChucVu"]');
            if (chucVuInput && !chucVuInput.closest('[style*="display:none"]')) {
                const val = chucVuInput.value ? chucVuInput.value.trim() : '';
                if (!val) {
                    markInvalid(chucVuInput, 'Vui lòng chọn chức vụ.');
                } else {
                    setInputError(chucVuInput, '');
                }
            }

            // 9. Mật khẩu mới (TRỪ PHẦN MẬT KHẨU MỚI RA - Bỏ trống nếu không đổi / mặc định)
            const passInput = form.querySelector('input[name="MatKhau"]');
            const newPassInput = form.querySelector('input[name="MatKhauMoi"]');
            const isCustomer = (form.action && form.action.toLowerCase().includes('createcustomer'))
                || form.querySelector('input[name="UserType"]')?.value === 'KHACHHANG'
                || Boolean(form.closest('#createCustomerModal'))
                || form.querySelector('input[name="MaKH"]') !== null;

            if (isCustomer) {
                // Tab Khách hàng: Ràng buộc giống trang register của user (tối thiểu 8 ký tự nếu nhập)
                if (passInput) {
                    const val = passInput.value.trim();
                    if (val && val.length < 8) {
                        markInvalid(passInput, 'Mật khẩu tối thiểu 8 ký tự.');
                    } else {
                        setInputError(passInput, '');
                    }
                }

                if (newPassInput) {
                    const val = newPassInput.value.trim();
                    if (val && val.length < 8) {
                        markInvalid(newPassInput, 'Mật khẩu mới tối thiểu 8 ký tự.');
                    } else {
                        setInputError(newPassInput, '');
                    }
                }
            } else {
                // Tab Nhân sự: Không có ràng buộc về mật khẩu
                if (passInput) {
                    setInputError(passInput, '');
                }
                if (newPassInput) {
                    setInputError(newPassInput, '');
                }
            }

            return { isValid, firstInvalidInput };
        }

        function checkCustomerPassword(input) {
            if (!input) return;
            const val = input.value.trim();
            if (val && val.length < 8) {
                const isEdit = input.name === 'MatKhauMoi';
                setInputError(input, isEdit ? 'Mật khẩu mới tối thiểu 8 ký tự.' : 'Mật khẩu tối thiểu 8 ký tự.');
            }
        }

        function clearCustomerPasswordError(input) {
            if (!input) return;
            const val = input.value.trim();
            if (!val || val.length >= 8) {
                setInputError(input, '');
            }
        }

        async function handleAccountFormSubmit(event, form) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            if (!form) return false;
            clearFormErrors(form);

            const pendingDmSelect = form.querySelector('select[id^="selectDm_"]');
            if (pendingDmSelect && pendingDmSelect.value) {
                const prefix = pendingDmSelect.id.replace(/^selectDm_/, '');
                addTag(prefix);
            }

            const validation = validateAccountForm(form);
            if (!validation.isValid) {
                if (validation.firstInvalidInput) {
                    validation.firstInvalidInput.focus();
                }
                return false;
            }

            const submitBtn = form.querySelector('button[type="submit"]');
            const origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...';
            }

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                const data = await response.json();
                if (!data.success) {
                    if (data.field) {
                        const target = form.querySelector(`[name="${data.field}"]`);
                        if (target) {
                            setInputError(target, data.message || 'Dữ liệu không hợp lệ.');
                            target.focus();
                        } else {
                            const alertBox = form.querySelector('.form-alert-modal');
                            if (alertBox) {
                                alertBox.textContent = data.message || 'Dữ liệu không hợp lệ.';
                                alertBox.style.display = 'block';
                            }
                        }
                    } else {
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) {
                            alertBox.textContent = data.message || 'Đã có lỗi xảy ra.';
                            alertBox.style.display = 'block';
                        }
                    }
                } else {
                    if (data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        window.location.reload();
                    }
                }
            } catch (err) {
                const alertBox = form.querySelector('.form-alert-modal');
                if (alertBox) {
                    alertBox.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                    alertBox.style.display = 'block';
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origBtnHtml;
                }
            }
            return false;
        }

        function initAccountManagement() {
            // Đăng ký event input/change để xóa lỗi khi sửa
            document.querySelectorAll('form.ajax-account-form').forEach(form => {
                form.addEventListener('input', function (e) {
                    if (e.target && e.target.matches('input, select, textarea')) {
                        if (e.target.name === 'MatKhau' || e.target.name === 'MatKhauMoi') {
                            clearCustomerPasswordError(e.target);
                        } else {
                            setInputError(e.target, '');
                        }
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) alertBox.style.display = 'none';
                    }
                });

                form.addEventListener('change', function (e) {
                    if (e.target && e.target.matches('input, select, textarea')) {
                        setInputError(e.target, '');
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) alertBox.style.display = 'none';
                    }
                });
            });

            // Lưu trạng thái HTML ban đầu của tagBox và dropdown sở thích
            document.querySelectorAll('[id^="tagBox_"]').forEach(box => {
                box.dataset.initialHtml = box.innerHTML;
            });
            document.querySelectorAll('[id^="selectDm_"]').forEach(select => {
                select.dataset.initialHtml = select.innerHTML;
            });

            function resetModalForm(modal) {
                if (!modal) return;
                const f = modal.querySelector('form.ajax-account-form');
                if (f) {
                    f.reset();
                    clearFormErrors(f);
                }
                // Khôi phục tagBox sở thích về trạng thái ban đầu
                const tagBox = modal.querySelector('[id^="tagBox_"]');
                if (tagBox && tagBox.dataset.initialHtml) {
                    tagBox.innerHTML = tagBox.dataset.initialHtml;
                }
                // Khôi phục dropdown danh mục sở thích
                const selectElem = modal.querySelector('[id^="selectDm_"]');
                if (selectElem && selectElem.dataset.initialHtml) {
                    selectElem.innerHTML = selectElem.dataset.initialHtml;
                    selectElem.selectedIndex = 0;
                }
                // Đưa các ô password về type="password" và icon con mắt
                modal.querySelectorAll('input[name="MatKhau"], input[name="MatKhauMoi"]').forEach(pwdInput => {
                    pwdInput.type = 'password';
                    const toggleBtn = pwdInput.parentElement ? pwdInput.parentElement.querySelector('button') : null;
                    if (toggleBtn) {
                        const icon = toggleBtn.querySelector('i');
                        if (icon) {
                            icon.classList.remove('fa-eye-slash');
                            icon.classList.add('fa-eye');
                        }
                    }
                });
            }

            // Khi đóng hoặc mở modal, luôn khôi phục lại dữ liệu ban đầu (tránh trường hợp bấm Hủy mà lần sau mở lại bị trống field)
            document.querySelectorAll('.modal').forEach(modal => {
                modal.addEventListener('hidden.bs.modal', function () {
                    resetModalForm(modal);
                });
                modal.addEventListener('show.bs.modal', function () {
                    resetModalForm(modal);
                });
            });

            // Tự động ẩn các thanh thông báo sau 5 giây
            document.querySelectorAll('.flash-auto-dismiss').forEach(alertEl => {
                setTimeout(() => {
                    try {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                        bsAlert.close();
                    } catch {
                        alertEl.style.display = 'none';
                    }
                }, 5000);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAccountManagement);
        } else {
            initAccountManagement();
        }

    </script>
</body>
</html>
