                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên Đăng Nhập Khách Hàng <span class="text-danger">*</span></label>
                            <input type="text" name="TenDangNhap" class="form-control" required placeholder="khachhang01" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật Khẩu Mặc Định <span class="text-danger">*</span></label>
                            <input type="password" name="MatKhau" class="form-control" required placeholder="••••••••" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và Tên Khách Hàng <span class="text-danger">*</span></label>
                            <input type="text" name="HoTen" class="form-control" required placeholder="Nguyễn Văn B" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                                <input type="email" name="Email" class="form-control" required placeholder="khachhang@gmail.com" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Số Điện Thoại</label>
                                <input type="text" name="SoDienThoai" class="form-control" placeholder="0987654321" />
                            </div>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Ngày sinh</label>
                                <input type="date" name="NgaySinh" class="form-control" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Giới tính</label>
                                <select name="GioiTinh" class="form-select">
                                    <option value="Nam">Nam</option>
                                    <option value="Nữ">Nữ</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Địa chỉ</label>
                            <input type="text" name="DiaChi" class="form-control" placeholder="Số 123 Đường ABC, Hà Nội" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Sở thích khách hàng</label>
                            <textarea name="SoThich" class="form-control" placeholder="Ví dụ: Áo thun cotton, Màu đen, Phong cách Streetwear" rows="2"></textarea>
