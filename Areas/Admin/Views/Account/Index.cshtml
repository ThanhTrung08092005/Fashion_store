    <!-- Modal 2: Thêm Quản Lý / Staff -->
    <div class="modal fade" id="createAccountModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-dark text-white">
                        <h5 class="modal-title fs-6 fw-bold"><i class="fa-solid fa-user-shield me-2"></i> Thêm Tài Khoản Quản Lý / Nhân Viên</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tên Đăng Nhập <span class="text-danger">*</span></label>
                            <input type="text" name="TenDangNhap" class="form-control" required placeholder="admin_user" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật Khẩu <span class="text-danger">*</span></label>
                            <input type="password" name="MatKhau" class="form-control" required placeholder="••••••••" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và Tên Nhân Sự <span class="text-danger">*</span></label>
                            <input type="text" name="HoTen" class="form-control" required placeholder="Trần Văn Admin" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-semibold">Email</label>
                                <input type="email" name="Email" class="form-control" placeholder="admin@fashionstore.com" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-semibold">Số Điện Thoại</label>
                                <input type="text" name="SoDienThoai" class="form-control" placeholder="0901234567" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-primary"><i class="fa-solid fa-briefcase me-1"></i> Chức Vụ & Phân Quyền <span class="text-danger">*</span></label>
                            <select name="ChucVu" class="form-select border-primary fw-bold" required>
                                <option value="Quản lý Cửa Hàng">Quản lý Cửa Hàng (Store Manager)</option>
                                <option value="Nhân viên Bán Hàng">Nhân viên Bán Hàng (Sales Staff)</option>
                                <option value="Nhân viên Kho">Nhân viên Kho (Warehouse Staff)</option>
                                <option value="Nhân viên Chăm Sóc Khách Hàng">Nhân viên Chăm Sóc Khách Hàng (CRM Staff)</option>
                            </select>
                            <input type="hidden" name="MaVaiTro" value="1" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-dark btn-sm"><i class="fa-solid fa-plus me-1"></i> Tạo Nhân Sự</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleAccountStatus(id, switchElem) {
            const labelElem = document.getElementById('status_text_' + id);
            fetch('/Admin/Account/ToggleStatus/' + id, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.newStatus) {
                        labelElem.textContent = 'Hoạt động';
                        labelElem.className = 'text-success';
                    } else {
                        labelElem.textContent = 'Bị khóa';
                        labelElem.className = 'text-danger';
                    }
                } else {
                    alert(data.message || 'Thao tác thất bại.');
                    switchElem.checked = !switchElem.checked;
                }
            })
            .catch(err => {
                alert('Lỗi kết nối máy chủ.');
                switchElem.checked = !switchElem.checked;
            });
        }
    </script>
</body>
</html>
