    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Biến đánh dấu nếu đã có thay đổi tồn kho biến thể
        window._productStockModified = false;
        // Danh sách biến thể hiện tại trong Modal Thêm / Sửa sản phẩm
        window._currentVariants = [];
        window._draftVariantCounter = 1;
        window._nextMaSP = @(ViewBag.NextMaSP ?? 1);
        window._openingEditProductModal = false;
        window._openingEditCategoryModal = false;

        // ==========================================
        // 1. QUẢN LÝ LỖI VALIDATION TẠI TỪNG TRƯỜNG (ĐỒNG BỘ VỚI ACCOUNT MANAGEMENT)
        // ==========================================
        function getFieldErrorElement(input) {
            if (!input) return null;
            const key = input.name || input.id || 'field';
            const fieldContainer = input.closest('.mb-3, .col-6, .col-12, .col-md-2, .col-md-3, .col-md-5, .col-md-6, .col-md-7, .form-group, .variant-input-wrap, .variant-field-col') || input.parentElement;
            if (!fieldContainer) return null;
            let err = fieldContainer.querySelector(`.invalid-feedback-custom[data-for="${key}"]`);
            if (!err) {
                const group = input.closest('.input-group') || input;
                err = document.createElement('div');
                err.className = 'invalid-feedback-custom';
                err.setAttribute('data-for', key);
                group.insertAdjacentElement('afterend', err);
            }
            return err;
        }

        function setInputError(input, message) {
            if (!input) return;
            const err = getFieldErrorElement(input);
            if (message) {
                input.classList.add('is-invalid');
                if (err) {
                    err.textContent = message;
                    err.style.display = 'block';
                }
            } else {
                input.classList.remove('is-invalid');
                if (err) {
                    err.textContent = '';
                    err.style.display = 'none';
                }
            }
        }

        function clearFormErrors(container) {
            if (!container) return;
            container.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
            container.querySelectorAll('.invalid-feedback-custom').forEach(el => {
                el.textContent = '';
                el.style.display = 'none';
            });
            const alertBox = container.querySelector('.form-alert-modal');
            if (alertBox) {
                alertBox.textContent = '';
                alertBox.style.display = 'none';
            }
        }

        function isValidImagePathClient(path) {
            if (!path) return true;
            if (path.length > 500) return false;
            if (path.startsWith('/')) {
                return !path.startsWith('//') && !path.includes('\\') && !path.split('/').includes('..');
            }
            return /^https?:\/\/.+/i.test(path);
        }

        // ==========================================
        // 2. XỬ LÝ ẢNH PREVIEW SẢN PHẨM
        // ==========================================
        function setProductImagePreview(kind, path) {
            const isThumbnail = kind === 'thumbnail';
            const preview = document.getElementById(isThumbnail ? 'prodThumbnailPreview' : 'prodDetailPreview');
            const pathLabel = document.getElementById(isThumbnail ? 'prodThumbnailPath' : 'prodDetailPath');
            const pathInput = document.getElementById(isThumbnail ? 'prodThumbnailPathInput' : 'prodDetailPathInput');
            if (!preview || !pathLabel) return;

            preview.dataset.savedPath = path || '';
            if (pathInput) pathInput.value = path || '';
            preview.onerror = () => { preview.style.display = 'none'; };
            if (path) {
                preview.src = path;
                preview.style.display = 'block';
                pathLabel.textContent = path;
            } else {
                preview.removeAttribute('src');
                preview.style.display = 'none';
                pathLabel.textContent = isThumbnail ? 'Chưa có ảnh thumbnail.' : 'Chưa có ảnh chi tiết.';
            }
        }

        [['thumbnail', 'prodThumbnailImage'], ['detail', 'prodDetailImage']].forEach(([kind, inputId]) => {
            const input = document.getElementById(inputId);
            input?.addEventListener('change', () => {
                const file = input.files?.[0];
                const pathInput = document.getElementById(kind === 'thumbnail' ? 'prodThumbnailPathInput' : 'prodDetailPathInput');
                setInputError(input, '');
                if (pathInput) setInputError(pathInput, '');

                if (!file) {
                    setProductImagePreview(kind, document.getElementById(kind === 'thumbnail' ? 'prodThumbnailPreview' : 'prodDetailPreview')?.dataset.savedPath || '');
                    return;
                }

                const preview = document.getElementById(kind === 'thumbnail' ? 'prodThumbnailPreview' : 'prodDetailPreview');
                const pathLabel = document.getElementById(kind === 'thumbnail' ? 'prodThumbnailPath' : 'prodDetailPath');
                if (pathInput) pathInput.value = '';
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
                pathLabel.textContent = `Ảnh sẽ thay thế: ${file.name}`;
            });
        });

        [['thumbnail', 'prodThumbnailPathInput'], ['detail', 'prodDetailPathInput']].forEach(([kind, inputId]) => {
            document.getElementById(inputId)?.addEventListener('input', event => {
                const path = event.target.value.trim();
                const fileInput = document.getElementById(kind === 'thumbnail' ? 'prodThumbnailImage' : 'prodDetailImage');
                if (fileInput) {
                    fileInput.value = '';
                    setInputError(fileInput, '');
                }
                setInputError(event.target, '');
                setProductImagePreview(kind, path);
            });
        });

        // ==========================================
        // 3. QUẢN LÝ BẢNG BIẾN THỂ & TỰ ĐỘNG KHỞI TẠO MÃ SKU (SP{MaSP}-{SIZE}-{MAU})
        // ==========================================
        window._editingVariantRowId = null;

        function toColorSkuCode(color) {
            if (!color) return '';
            return color
                .trim()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd')
                .replace(/Đ/g, 'D')
                .replace(/[^a-zA-Z0-9]/g, '')
                .toUpperCase();
        }

        function generateAutoSku(maSP, size, color, excludeRowId) {
            const prodId = maSP || window._nextMaSP || 1;
            const cleanSize = size ? size.trim().toUpperCase() : 'SIZE';
            const cleanColor = toColorSkuCode(color) || 'MAU';
            const baseSku = `SP${prodId}-${cleanSize}-${cleanColor}`;

            if (!size || !color) {
                return baseSku;
            }

            let candidate = baseSku;
            let suffix = 2;
            while (
                window._currentVariants &&
                window._currentVariants.some(v =>
                    String(v.rowId) !== String(excludeRowId ?? '') &&
                    v.sku &&
                    v.sku.toUpperCase() === candidate
                )
            ) {
                candidate = `${baseSku}-${suffix}`;
                suffix++;
            }
            return candidate;
        }

        function updatePreviewSkuInEditModal() {
            const sizeInput = document.getElementById('newV_KichThuoc');
            const colorInput = document.getElementById('newV_MauSac');
            const skuInput = document.getElementById('newV_SKU');
            const maSP = document.getElementById('prodMaSP')?.value.trim() || '';
            if (!skuInput) return;

            const size = sizeInput ? sizeInput.value.trim() : '';
            const color = colorInput ? colorInput.value.trim() : '';
            skuInput.value = generateAutoSku(maSP, size, color, window._editingVariantRowId);
            setInputError(skuInput, '');
        }

        function updatePreviewSkuInStandaloneModal(selectElem) {
            if (!selectElem) return;
            const form = selectElem.closest('form');
            if (!form) return;
            const sizeSelect = form.querySelector('select[name="KichThuoc"]');
            const colorSelect = form.querySelector('select[name="MauSac"]');
            const skuInput = form.querySelector('input[name="SKU"]');
            const maSP = form.querySelector('input[name="MaSP"]')?.value.trim() || '';
            if (!skuInput) return;

            const size = sizeSelect ? sizeSelect.value.trim() : '';
            const color = colorSelect ? colorSelect.value.trim() : '';
            skuInput.value = generateAutoSku(maSP, size, color);
            setInputError(skuInput, '');
        }

        function resetNewVariantBoxInputs() {
            window._editingVariantRowId = null;
            const sizeEl = document.getElementById('newV_KichThuoc');
            const colorEl = document.getElementById('newV_MauSac');
            const skuEl = document.getElementById('newV_SKU');
            const stockEl = document.getElementById('newV_SoLuongTon');
            const titleEl = document.getElementById('variantBoxTitle');
            const submitBtn = document.getElementById('btnSubmitVariantBox');
            const maSP = document.getElementById('prodMaSP')?.value.trim() || '';

            if (sizeEl) sizeEl.value = '';
            if (colorEl) colorEl.value = '';
            if (skuEl) skuEl.value = generateAutoSku(maSP, '', '');
            if (stockEl) stockEl.value = '';
            if (titleEl) {
                titleEl.innerHTML = '<i class="fa-solid fa-plus me-1"></i> Thêm biến thể size mới cho mẫu áo này';
            }
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-plus"></i> THÊM';
                submitBtn.classList.remove('btn-primary');
                submitBtn.classList.add('btn-dark');
            }
        }

        function closeVariantBoxInEditModal() {
            const box = document.getElementById('addVariantInEditBox');
            if (!box) return;
            clearFormErrors(box);
            resetNewVariantBoxInputs();
            box.style.display = 'none';
            renderVariantsTable();
        }

        function initDefaultDraftVariants() {
            window._draftVariantCounter = 1;
            window._currentVariants = [];
            renderVariantsTable();
        }

        function getStockStatusBadgeHtml(stockVal) {
            const n = parseInt(stockVal, 10);
            if (isNaN(n) || n <= 0) {
                return '<span class="badge badge-stock-out badge-pill-custom"><i class="fa-solid fa-circle-xmark me-1"></i>Hết hàng</span>';
            }
            if (n <= 10) {
                return '<span class="badge badge-stock-low badge-pill-custom"><i class="fa-solid fa-triangle-exclamation me-1"></i>Sắp hết</span>';
            }
            return '<span class="badge badge-stock-high badge-pill-custom"><i class="fa-solid fa-circle-check me-1"></i>Còn hàng</span>';
        }

        function updateTotalStockBadge() {
            let totalStock = 0;
            window._currentVariants.forEach(v => {
                const stockNum = parseInt(v.soLuongTon, 10);
                if (!isNaN(stockNum) && stockNum > 0) {
                    totalStock += stockNum;
                }
            });
            const badge = document.getElementById('editModalTotalStock');
            if (badge) {
                badge.textContent = 'Tổng tồn: ' + totalStock.toLocaleString('vi-VN') + ' cái';
            }
        }

        function onVariantRowInput(rowId, field, inputElem) {
            setInputError(inputElem, '');
            const v = window._currentVariants.find(item => String(item.rowId) === String(rowId));
            if (v) {
                v[field] = inputElem.value;
            }
            if (field === 'soLuongTon') {
                updateTotalStockBadge();
                const statusCell = document.getElementById('vStatus_' + rowId);
                if (statusCell) {
                    statusCell.innerHTML = getStockStatusBadgeHtml(inputElem.value);
                }
            }
        }

        function renderVariantsTable() {
            const tbody = document.getElementById('editModalVariantsTbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const variantsErr = document.getElementById('variantsSectionError');
            if (variantsErr) {
                variantsErr.textContent = '';
                variantsErr.style.display = 'none';
            }
            const tableContainer = document.getElementById('variantsTableContainer');
            if (tableContainer) {
                tableContainer.classList.remove('border-danger');
            }

            if (!window._currentVariants || window._currentVariants.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-muted py-3">Chưa có biến thể size/màu nào. Hãy bấm nút <strong>+ Thêm Size / Màu Mới</strong> bên dưới để chọn size.</td></tr>';
                updateTotalStockBadge();
                return;
            }

            const maSP = document.getElementById('prodMaSP')?.value.trim() || '';
            const isCreateMode = !maSP;
            window._currentVariants.forEach((v, idx) => {
                if (!v.sku) {
                    v.sku = generateAutoSku(maSP, v.kichThuoc, v.mauSac, v.rowId);
                }
                const tr = document.createElement('tr');
                if (String(window._editingVariantRowId) === String(v.rowId)) {
                    tr.classList.add('table-primary');
                }
                const canDelete = isCreateMode || window._currentVariants.length > 1;
                tr.innerHTML = `
                    <td>
                        <span class="badge bg-dark">Size ${v.kichThuoc}</span>
                        <input type="hidden" name="Variants[${idx}].MaSL" value="${v.maSL ?? ''}" />
                        <input type="hidden" name="Variants[${idx}].KichThuoc" value="${v.kichThuoc}" />
                        <input type="hidden" name="Variants[${idx}].MauSac" value="${v.mauSac}" />
                        <input type="hidden" name="Variants[${idx}].SKU" value="${v.sku}" />
                    </td>
                    <td><span class="badge bg-light text-dark border">${v.mauSac}</span></td>
                    <td class="font-monospace fw-bold small text-dark">${v.sku}</td>
                    <td>
                        <div class="variant-input-wrap d-inline-block text-start" style="width: 95px;">
                            <input type="number" id="vStock_${v.rowId}" name="Variants[${idx}].SoLuongTon"
                                   class="form-control form-control-sm text-center fw-bold"
                                   value="${v.soLuongTon}" min="0" max="100000" step="1"
                                   oninput="onVariantRowInput('${v.rowId}', 'soLuongTon', this)" />
                        </div>
                    </td>
                    <td id="vStatus_${v.rowId}">
                        ${getStockStatusBadgeHtml(v.soLuongTon)}
                    </td>
                    <td>
                        <div class="d-inline-flex gap-1">
                            <button type="button" id="btnEditV_${v.rowId}" class="btn btn-sm btn-outline-primary px-2"
                                    onclick="openEditVariantRow('${v.rowId}')" title="Sửa chi tiết size này (Size, Màu, Tồn kho)">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            ${canDelete ? `
                            <button type="button" class="btn btn-sm btn-outline-danger px-2"
                                    onclick="promptDeleteVariant('${v.rowId}', '${v.sku}', '${v.kichThuoc}', '${v.mauSac}')" title="Xóa size này">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>` : `
                            <button type="button" class="btn btn-sm btn-outline-secondary px-2 opacity-50" disabled
                                    title="Mỗi sản phẩm phải có ít nhất 1 biến thể">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>`}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            updateTotalStockBadge();
        }

        // Mở khung sửa chi tiết cho 1 dòng size cụ thể
        function openEditVariantRow(rowId) {
            const v = window._currentVariants.find(item => String(item.rowId) === String(rowId));
            if (!v) return;

            const box = document.getElementById('addVariantInEditBox');
            if (!box) return;
            clearFormErrors(box);

            window._editingVariantRowId = v.rowId;
            const sizeEl = document.getElementById('newV_KichThuoc');
            const colorEl = document.getElementById('newV_MauSac');
            const skuEl = document.getElementById('newV_SKU');
            const stockEl = document.getElementById('newV_SoLuongTon');
            const titleEl = document.getElementById('variantBoxTitle');
            const submitBtn = document.getElementById('btnSubmitVariantBox');

            if (sizeEl) sizeEl.value = v.kichThuoc || '';
            if (colorEl) {
                const hasOpt = Array.from(colorEl.options).some(o => o.value.toLowerCase() === (v.mauSac || '').toLowerCase());
                if (!hasOpt && v.mauSac) {
                    const opt = document.createElement('option');
                    opt.value = v.mauSac;
                    opt.textContent = v.mauSac;
                    colorEl.appendChild(opt);
                }
                const matchedOpt = Array.from(colorEl.options).find(o => o.value.toLowerCase() === (v.mauSac || '').toLowerCase());
                colorEl.value = matchedOpt ? matchedOpt.value : '';
            }
            if (skuEl) skuEl.value = v.sku || '';
            if (stockEl) stockEl.value = v.soLuongTon ?? '';

            if (titleEl) {
                titleEl.innerHTML = `<i class="fa-solid fa-pen-to-square me-1"></i> Sửa chi tiết biến thể: Size ${v.kichThuoc} - Màu ${v.mauSac}`;
            }
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-check"></i> LƯU SỬA';
                submitBtn.classList.remove('btn-dark');
                submitBtn.classList.add('btn-primary');
            }

            box.style.display = 'block';
            renderVariantsTable();
            if (sizeEl) sizeEl.focus();
        }

        // Mở Modal Sửa Sản Phẩm (Tự động tải danh sách toàn bộ các size & tồn kho + giá niêm yết chung)
        async function openEditProductModal(id, tenSP, maDM, chatLieu, moTa, giaBan) {
            window._openingEditProductModal = true;
            window._productStockModified = false;

            const form = document.querySelector('#modalAddProduct form');
            clearFormErrors(form);

            document.getElementById('modalProductTitle').innerHTML = '<i class="fa-solid fa-pen-to-square me-2 text-warning"></i> CẬP NHẬT MẪU ÁO #' + id;
            document.getElementById('prodMaSP').value = id;
            document.getElementById('prodTenSP').value = tenSP;
            document.getElementById('prodMaDM').value = maDM;
            document.getElementById('prodChatLieu').value = chatLieu || '';
            if (document.getElementById('prodGiaBan')) {
                document.getElementById('prodGiaBan').value = (giaBan !== undefined && giaBan !== null && Number(giaBan) > 0) ? Math.round(Number(giaBan)) : '';
            }
            document.getElementById('prodMoTa').value = moTa || '';
            if (document.getElementById('prodTrangThai')) document.getElementById('prodTrangThai').value = 'true';
            document.getElementById('prodThumbnailImage').value = '';
            document.getElementById('prodDetailImage').value = '';
            setProductImagePreview('thumbnail', '');
            setProductImagePreview('detail', '');

            resetNewVariantBoxInputs();
            document.getElementById('editVariantsSection').style.display = 'block';
            document.getElementById('addVariantInEditBox').style.display = 'none';

            // Tải danh sách biến thể của áo qua AJAX
            await loadProductVariantsForEdit(id);

            var modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAddProduct'));
            modal.show();
            window._openingEditProductModal = false;
        }

        // Tải danh sách toàn bộ biến thể của 1 áo và tính tổng tồn kho
        async function loadProductVariantsForEdit(productId) {
            try {
                const res = await fetch('/Admin/Product/GetVariants?productId=' + productId);
                const data = await res.json();
                if (!data.success) {
                    return;
                }

                const firstVariantImage = data.variants?.find(variant => variant.hinhAnh)?.hinhAnh || '';
                setProductImagePreview('thumbnail', data.hinhAnh || firstVariantImage);
                setProductImagePreview('detail', data.hinhAnhMoTa || '');

                const priceInput = document.getElementById('prodGiaBan');
                if (priceInput && data.giaBan && Number(data.giaBan) > 0) {
                    priceInput.value = Math.round(Number(data.giaBan));
                }

                window._currentVariants = (data.variants || []).map(v => ({
                    rowId: v.maSL,
                    maSL: v.maSL,
                    kichThuoc: v.kichThuoc,
                    mauSac: v.mauSac,
                    sku: v.sku,
                    soLuongTon: v.soLuongTon
                }));

                renderVariantsTable();
            } catch (err) {
                console.error(err);
            }
        }

        // Kiểm tra hợp lệ 1 dòng biến thể trong bảng
        function validateSingleVariantRow(rowId) {
            const stockInput = document.getElementById('vStock_' + rowId);
            let valid = true;

            if (stockInput) {
                const rawStock = stockInput.value.trim();
                const stockVal = Number(rawStock);
                if (rawStock === '') {
                    setInputError(stockInput, 'Tồn kho không được để trống.');
                    valid = false;
                } else if (isNaN(stockVal) || stockVal < 0 || !Number.isInteger(stockVal)) {
                    setInputError(stockInput, 'Tồn kho phải là số nguyên >= 0.');
                    valid = false;
                } else if (stockVal > 100000) {
                    setInputError(stockInput, 'Tồn kho tối đa 100.000 cái.');
                    valid = false;
                } else {
                    setInputError(stockInput, '');
                }
            }

            return valid;
        }

        // Xóa một biến thể trong modal Thêm / Sửa
        async function deleteVariantFromEditModal(rowId) {
            const v = window._currentVariants.find(item => String(item.rowId) === String(rowId));
            if (!v) return;

            const maSP = document.getElementById('prodMaSP').value;
            if (!maSP || !v.maSL) {
                // Chế độ Thêm mới (xóa dòng biến thể khỏi danh sách tạm)
                window._currentVariants = window._currentVariants.filter(item => String(item.rowId) !== String(rowId));
                if (String(window._editingVariantRowId) === String(rowId)) {
                    closeVariantBoxInEditModal();
                } else {
                    renderVariantsTable();
                }
                return;
            }

            if (window._currentVariants.length <= 1) {
                const variantsErr = document.getElementById('variantsSectionError');
                if (variantsErr) {
                    variantsErr.textContent = 'Không thể xóa biến thể cuối cùng! Mỗi sản phẩm phải có ít nhất 1 biến thể (Size & Màu).';
                    variantsErr.style.display = 'block';
                }
                return;
            }

            if (!confirm('Bạn có chắc chắn muốn xóa biến thể SKU: ' + v.sku + '?')) return;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', getCsrfToken());
            formData.append('id', v.maSL);

            try {
                const res = await fetch('/Admin/Product/DeleteVariant', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    window._productStockModified = true;
                    if (String(window._editingVariantRowId) === String(rowId)) {
                        resetNewVariantBoxInputs();
                        document.getElementById('addVariantInEditBox').style.display = 'none';
                    }
                    await loadProductVariantsForEdit(maSP);
                } else {
                    const alertBox = document.querySelector('#modalAddProduct .form-alert-modal');
                    if (alertBox) {
                        alertBox.textContent = data.message || 'Không thể xóa biến thể.';
                        alertBox.style.display = 'block';
                    }
                }
            } catch (err) {
                console.error(err);
            }
        }

        // Toggle mở form thêm biến thể mới trong modal Thêm / Sửa
        function toggleAddVariantInEditModal() {
            const box = document.getElementById('addVariantInEditBox');
            if (!box) return;
            clearFormErrors(box);
            if (box.style.display === 'none' || window._editingVariantRowId !== null) {
                resetNewVariantBoxInputs();
                box.style.display = 'block';
                renderVariantsTable();
            } else {
                box.style.display = 'none';
            }
        }

        // Thêm mới HOẶC Lưu sửa chi tiết 1 biến thể trong modal Thêm / Sửa
        async function submitNewVariantInEditModal() {
            const box = document.getElementById('addVariantInEditBox');
            clearFormErrors(box);

            const editingRowId = window._editingVariantRowId;
            const isEditingVariant = editingRowId !== null && editingRowId !== undefined;
            const editingVariant = isEditingVariant
                ? window._currentVariants.find(item => String(item.rowId) === String(editingRowId))
                : null;

            const maSP = document.getElementById('prodMaSP').value.trim();
            const sizeInput = document.getElementById('newV_KichThuoc');
            const colorInput = document.getElementById('newV_MauSac');
            const skuInput = document.getElementById('newV_SKU');
            const stockInput = document.getElementById('newV_SoLuongTon');

            const size = sizeInput.value.trim();
            const color = colorInput.value.trim();
            skuInput.value = generateAutoSku(maSP, size, color, editingRowId);
            let sku = skuInput.value.trim();
            const rawStock = stockInput.value.trim();

            let isValid = true;
            let firstInvalid = null;
            function markBoxInvalid(input, msg) {
                setInputError(input, msg);
                isValid = false;
                if (!firstInvalid) firstInvalid = input;
            }

            if (!size) {
                markBoxInvalid(sizeInput, 'Vui lòng chọn kích thước (Size).');
            }
            if (!color) {
                markBoxInvalid(colorInput, 'Vui lòng chọn màu sắc.');
            } else if (color.length > 50) {
                markBoxInvalid(colorInput, 'Màu sắc tối đa 50 ký tự.');
            }

            const stock = Number(rawStock);
            if (rawStock === '') {
                markBoxInvalid(stockInput, 'Số lượng tồn không được để trống.');
            } else if (isNaN(stock) || stock < 0 || !Number.isInteger(stock)) {
                markBoxInvalid(stockInput, 'Số lượng tồn phải là số nguyên >= 0.');
            } else if (stock > 100000) {
                markBoxInvalid(stockInput, 'Số lượng tồn tối đa 100.000 cái.');
            }

            if (isValid) {
                // Kiểm tra trùng lặp Size + Màu sắc trong bảng hiện tại (bỏ qua dòng đang sửa)
                const duplicateSizeColor = window._currentVariants.some(
                    v => String(v.rowId) !== String(editingRowId ?? '') &&
                         v.kichThuoc.toUpperCase() === size.toUpperCase() &&
                         v.mauSac.toLowerCase() === color.toLowerCase()
                );
                if (duplicateSizeColor) {
                    markBoxInvalid(colorInput, `Biến thể Size ${size} - Màu ${color} đã tồn tại trong danh sách.`);
                }

                // Cập nhật lại mã SKU theo chuẩn SP{MaSP}-{SIZE}-{MAU}
                sku = generateAutoSku(maSP, size, color, editingRowId);
                skuInput.value = sku;
            }

            if (!isValid) {
                if (firstInvalid) firstInvalid.focus();
                return;
            }

            // Nếu đang ở chế độ Thêm mới sản phẩm (chưa có MaSP) hoặc biến thể nháp chưa lưu DB
            if (!maSP || (editingVariant && !editingVariant.maSL)) {
                if (editingVariant) {
                    editingVariant.kichThuoc = size;
                    editingVariant.mauSac = color;
                    editingVariant.sku = sku.toUpperCase();
                    editingVariant.soLuongTon = stock;
                } else {
                    window._currentVariants.push({
                        rowId: 'draft_' + (window._draftVariantCounter++),
                        maSL: null,
                        kichThuoc: size,
                        mauSac: color,
                        sku: sku.toUpperCase(),
                        soLuongTon: stock
                    });
                }
                resetNewVariantBoxInputs();
                box.style.display = 'none';
                renderVariantsTable();
                return;
            }

            // Nếu đang ở chế độ Cập nhật sản phẩm đã có MaSP -> lưu thêm mới hoặc cập nhật biến thể vào CSDL qua AJAX
            if (!sku) {
                sku = generateAutoSku(maSP, size, color, editingRowId);
            }

            const prodGiaBanInput = document.getElementById('prodGiaBan');
            const unifiedPriceVal = prodGiaBanInput && Number(prodGiaBanInput.value) >= 1000
                ? Math.round(Number(prodGiaBanInput.value))
                : 0;

            const formData = new FormData();
            formData.append('__RequestVerificationToken', getCsrfToken());
            if (editingVariant && editingVariant.maSL) {
                formData.append('MaSL', editingVariant.maSL);
            }
            formData.append('MaSP', maSP);
            formData.append('SKU', sku);
            formData.append('KichThuoc', size);
            formData.append('MauSac', color);
            if (unifiedPriceVal >= 1000) {
                formData.append('GiaBan', unifiedPriceVal);
            }
            formData.append('SoLuongTon', stock);
            formData.append('TrangThai', 'true');

            try {
                const res = await fetch('/Admin/Product/SaveVariant', {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    window._productStockModified = true;
                    resetNewVariantBoxInputs();
                    box.style.display = 'none';
                    await loadProductVariantsForEdit(maSP);
                } else {
                    const targetInput = data.field === 'MauSac' ? colorInput : skuInput;
                    setInputError(targetInput, data.message || 'Không thể lưu biến thể.');
                }
            } catch (err) {
                setInputError(skuInput, 'Lỗi kết nối máy chủ.');
            }
        }

        // ==========================================
        // 4. VALIDATION & SUBMIT FORM SẢN PHẨM (CHUẨN THƯƠNG MẠI ĐIỆN TỬ)
        // ==========================================
        function validateProductForm(form) {
            let isValid = true;
            let firstInvalidInput = null;

            function markInvalid(input, msg) {
                if (!input) return;
                setInputError(input, msg);
                isValid = false;
                if (!firstInvalidInput) firstInvalidInput = input;
            }

            // 1. Tên sản phẩm áo
            const tenInput = form.querySelector('#prodTenSP');
            if (tenInput) {
                const val = tenInput.value.trim();
                if (!val) {
                    markInvalid(tenInput, 'Tên sản phẩm áo không được để trống.');
                } else if (val.length < 3) {
                    markInvalid(tenInput, 'Tên sản phẩm áo phải có ít nhất 3 ký tự.');
                } else if (val.length > 200) {
                    markInvalid(tenInput, 'Tên sản phẩm áo không được vượt quá 200 ký tự.');
                } else {
                    setInputError(tenInput, '');
                }
            }

            // 2. Danh mục áo
            const dmInput = form.querySelector('#prodMaDM');
            if (dmInput) {
                const val = dmInput.value.trim();
                if (!val) {
                    markInvalid(dmInput, 'Vui lòng chọn danh mục áo.');
                } else {
                    setInputError(dmInput, '');
                }
            }

            // 3. Chất liệu vải
            const chatLieuInput = form.querySelector('#prodChatLieu');
            if (chatLieuInput) {
                const val = chatLieuInput.value.trim();
                if (!val) {
                    markInvalid(chatLieuInput, 'Chất liệu vải không được để trống.');
                } else if (val.length < 2) {
                    markInvalid(chatLieuInput, 'Chất liệu vải phải có ít nhất 2 ký tự.');
                } else if (val.length > 100) {
                    markInvalid(chatLieuInput, 'Chất liệu vải không được vượt quá 100 ký tự.');
                } else {
                    setInputError(chatLieuInput, '');
                }
            }

            // 4. Giá bán niêm yết (VNĐ) chung cho mẫu áo
            const giaBanInput = form.querySelector('#prodGiaBan');
            if (giaBanInput) {
                const rawPrice = giaBanInput.value.trim();
                const priceNum = Number(rawPrice);
                if (!rawPrice) {
                    markInvalid(giaBanInput, 'Giá bán niêm yết không được để trống.');
                } else if (isNaN(priceNum) || !Number.isInteger(priceNum)) {
                    markInvalid(giaBanInput, 'Giá bán niêm yết phải là số nguyên (VNĐ).');
                } else if (priceNum < 1000 || priceNum > 100000000) {
                    markInvalid(giaBanInput, 'Giá bán niêm yết phải từ 1.000 đ đến 100.000.000 đ.');
                } else {
                    setInputError(giaBanInput, '');
                }
            }

            // 5. Mô tả sản phẩm
            const moTaInput = form.querySelector('#prodMoTa');
            if (moTaInput) {
                const val = moTaInput.value.trim();
                if (!val) {
                    markInvalid(moTaInput, 'Mô tả sản phẩm không được để trống.');
                } else if (val.length > 2000) {
                    markInvalid(moTaInput, 'Mô tả sản phẩm không được vượt quá 2.000 ký tự.');
                } else {
                    setInputError(moTaInput, '');
                }
            }

            // 6. Ảnh thumbnail / ảnh đại diện
            const thumbFile = form.querySelector('#prodThumbnailImage');
            const thumbPath = form.querySelector('#prodThumbnailPathInput');
            const hasThumbFile = thumbFile && thumbFile.files && thumbFile.files.length > 0;
            const thumbPathVal = thumbPath ? thumbPath.value.trim() : '';
            if (!hasThumbFile && !thumbPathVal) {
                markInvalid(thumbPath, 'Ảnh thumbnail / ảnh đại diện không được để trống.');
            } else if (thumbPathVal && !isValidImagePathClient(thumbPathVal)) {
                markInvalid(thumbPath, 'Đường dẫn ảnh thumbnail phải bắt đầu bằng / hoặc http(s)://.');
            } else {
                setInputError(thumbPath, '');
            }

            // 7. Ảnh chi tiết sản phẩm
            const detailFile = form.querySelector('#prodDetailImage');
            const detailPath = form.querySelector('#prodDetailPathInput');
            const hasDetailFile = detailFile && detailFile.files && detailFile.files.length > 0;
            const detailPathVal = detailPath ? detailPath.value.trim() : '';
            if (!hasDetailFile && !detailPathVal) {
                markInvalid(detailPath, 'Ảnh chi tiết sản phẩm không được để trống.');
            } else if (detailPathVal && !isValidImagePathClient(detailPathVal)) {
                markInvalid(detailPath, 'Đường dẫn ảnh chi tiết phải bắt đầu bằng / hoặc http(s)://.');
            } else {
                setInputError(detailPath, '');
            }

            // 8. Kiểm tra danh sách biến thể & khung chọn Size
            const addVariantBox = document.getElementById('addVariantInEditBox');
            const variantsErr = document.getElementById('variantsSectionError');
            const tableContainer = document.getElementById('variantsTableContainer');
            const hasNoVariants = !window._currentVariants || window._currentVariants.length === 0;

            if (hasNoVariants) {
                if (variantsErr) {
                    variantsErr.textContent = 'Vui lòng chọn kích thước (Size), Màu sắc, nhập Số lượng tồn và bấm THÊM ít nhất 1 biến thể cho sản phẩm.';
                    variantsErr.style.display = 'block';
                }
                if (tableContainer) {
                    tableContainer.classList.add('border-danger');
                }
                // Mở khung thêm biến thể và báo lỗi ngay tại các trường chưa chọn/nhập
                if (addVariantBox && addVariantBox.style.display === 'none') {
                    addVariantBox.style.display = 'block';
                }
                isValid = false;
            } else {
                if (variantsErr) {
                    variantsErr.textContent = '';
                    variantsErr.style.display = 'none';
                }
                if (tableContainer) {
                    tableContainer.classList.remove('border-danger');
                }
                window._currentVariants.forEach(v => {
                    if (!validateSingleVariantRow(v.rowId)) {
                        isValid = false;
                        if (!firstInvalidInput) {
                            firstInvalidInput = document.getElementById('vStock_' + v.rowId);
                        }
                    }
                });
            }

            // 9. Nếu khung Thêm/Sửa biến thể đang mở, kiểm tra bắt buộc chọn Size, Màu sắc và điền đủ Số lượng tồn
            if (addVariantBox && addVariantBox.style.display !== 'none') {
                const newSizeInput = document.getElementById('newV_KichThuoc');
                const newColorInput = document.getElementById('newV_MauSac');
                const newStockInput = document.getElementById('newV_SoLuongTon');

                const sizeVal = newSizeInput ? newSizeInput.value.trim() : '';
                const colorVal = newColorInput ? newColorInput.value.trim() : '';
                const sVal = newStockInput ? newStockInput.value.trim() : '';

                const isTypingVariant = Boolean(sizeVal || colorVal || sVal !== '');
                if (hasNoVariants || isTypingVariant) {
                    if (newSizeInput && !sizeVal) {
                        markInvalid(newSizeInput, 'Vui lòng chọn kích thước (Size).');
                    }
                    if (newColorInput && !colorVal) {
                        markInvalid(newColorInput, 'Vui lòng chọn màu sắc.');
                    }
                    if (newStockInput) {
                        if (sVal === '') {
                            markInvalid(newStockInput, 'Số lượng tồn không được để trống.');
                        } else if (Number(sVal) < 0 || !Number.isInteger(Number(sVal)) || Number(sVal) > 100000) {
                            markInvalid(newStockInput, 'Số lượng tồn phải là số nguyên từ 0 đến 100.000.');
                        }
                    }
                    if (sizeVal && colorVal && sVal !== '' && Number(sVal) >= 0 && Number.isInteger(Number(sVal)) && Number(sVal) <= 100000) {
                        const btnLabel = window._editingVariantRowId !== null ? 'LƯU SỬA' : 'THÊM';
                        if (variantsErr) {
                            variantsErr.textContent = `Bạn đang nhập/sửa thông tin biến thể, vui lòng bấm nút "${btnLabel}" để hoàn tất trước khi Lưu.`;
                            variantsErr.style.display = 'block';
                        }
                        isValid = false;
                    }
                }
            }

            return { isValid, firstInvalidInput };
        }

        async function handleProductFormSubmit(event, form) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            if (!form) return false;
            clearFormErrors(form);

            const validation = validateProductForm(form);
            if (!validation.isValid) {
                if (validation.firstInvalidInput) {
                    validation.firstInvalidInput.focus();
                }
                return false;
            }

            const submitBtn = form.querySelector('button[type="submit"]');
            const origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang lưu...';
            }

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    }
                });

                const data = await response.json();
                if (!data.success) {
                    if (data.field) {
                        const target = form.querySelector(`[name="${data.field}"]`);
                        if (target) {
                            setInputError(target, data.message || 'Dữ liệu không hợp lệ.');
                            target.focus();
                        } else if (data.field === 'Variants') {
                            const variantsErr = document.getElementById('variantsSectionError');
                            if (variantsErr) {
                                variantsErr.textContent = data.message || 'Dữ liệu biến thể không hợp lệ.';
                                variantsErr.style.display = 'block';
                            }
                        } else {
                            const alertBox = form.querySelector('.form-alert-modal');
                            if (alertBox) {
                                alertBox.textContent = data.message || 'Dữ liệu không hợp lệ.';
                                alertBox.style.display = 'block';
                            }
                        }
                    } else {
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) {
                            alertBox.textContent = data.message || 'Đã có lỗi xảy ra.';
                            alertBox.style.display = 'block';
                        }
                    }
                } else {
                    if (data.redirectUrl) {
                        window.location.href = data.redirectUrl;
                    } else {
                        window.location.reload();
                    }
                }
            } catch (err) {
                const alertBox = form.querySelector('.form-alert-modal');
                if (alertBox) {
                    alertBox.textContent = 'Lỗi kết nối máy chủ. Vui lòng thử lại sau.';
                    alertBox.style.display = 'block';
                }
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origBtnHtml;
                }
            }
            return false;
        }

