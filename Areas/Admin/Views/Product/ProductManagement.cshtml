                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-cancel-delete" data-bs-dismiss="modal">Hủy</button>
                        <button type="button" id="btnConfirmDeleteSubmit" class="btn-confirm-delete" onclick="handleExecuteDeleteSubmit(event)">
                            <i class="fa-solid fa-trash-can me-1"></i> Xác nhận xóa
                        </button>
