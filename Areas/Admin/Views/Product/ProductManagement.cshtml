                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteTargetId" name="id" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title fs-6 fw-bold d-flex align-items-center" id="deleteModalTitle">
