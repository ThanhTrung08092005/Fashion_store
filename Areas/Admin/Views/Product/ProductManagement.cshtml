        // Tự động xóa lỗi validation khi người dùng nhập hoặc chọn lại dữ liệu
        function initProductManagementValidation() {
            initDefaultDraftVariants();

            document.querySelectorAll('#modalAddProduct form, #modalAddCategory form, #newVariantBox form').forEach(form => {
                form.addEventListener('input', function (e) {
                    if (e.target && e.target.matches('input, select, textarea')) {
                        setInputError(e.target, '');
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) alertBox.style.display = 'none';
                    }
                });
                form.addEventListener('change', function (e) {
                    if (e.target && e.target.matches('input, select, textarea')) {
                        setInputError(e.target, '');
                        const alertBox = form.querySelector('.form-alert-modal');
                        if (alertBox) alertBox.style.display = 'none';
                    }
                });
            });
            // Tự động ẩn các thanh thông báo sau 5 giây
            document.querySelectorAll('.flash-auto-dismiss').forEach(alertEl => {
                setTimeout(() => {
                    try {
                        const bsAlert = bootstrap.Alert.getOrCreateInstance(alertEl);
                        bsAlert.close();
                    } catch {
                        alertEl.style.display = 'none';
                    }
                }, 5000);
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initProductManagementValidation);
        } else {
            initProductManagementValidation();
        }

        window._actionMsgTimer = null;
        function showAutoDismissActionMessage(typeClass, text) {
            const message = document.getElementById('product-action-message');
            if (!message) return;
            if (window._actionMsgTimer) clearTimeout(window._actionMsgTimer);
            message.className = `alert ${typeClass} alert-dismissible fade show`;
            message.innerHTML = `${text}<button type="button" class="btn-close" onclick="this.parentElement.className='alert d-none'"></button>`;
            message.scrollIntoView({ behavior: 'smooth', block: 'center' });
            window._actionMsgTimer = setTimeout(() => {
                message.className = 'alert d-none';
            }, 5000);
        }

        // ==========================================
        // QUẢN LÝ MODAL XÁC NHẬN XÓA HIỆN ĐẠI (ĐỒNG BỘ ACCOUNT MANAGEMENT)
        // ==========================================
        let _pendingDeleteCallback = null;

        function showConfirmDeleteDialog({ title, subjectTitle, subjectDesc, note, confirmBtnText = 'Xác nhận xóa', onConfirm }) {
            document.getElementById('deleteModalTitle').innerHTML = `<i class="fa-solid fa-triangle-exclamation text-danger me-2"></i> ${title}`;
            document.getElementById('deleteModalSubjectTitle').textContent = subjectTitle;
            document.getElementById('deleteModalSubjectDesc').innerHTML = subjectDesc;
            document.getElementById('deleteModalSubjectNote').innerHTML = note;
            
            const btnConfirm = document.getElementById('btnConfirmDeleteSubmit');
            btnConfirm.innerHTML = `<i class="fa-solid fa-trash-can me-1"></i> ${confirmBtnText}`;
            btnConfirm.disabled = false;
            
            _pendingDeleteCallback = onConfirm;
            
            const modalEl = document.getElementById('modalConfirmDelete');
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();
        }

        document.getElementById('modalConfirmDelete')?.addEventListener('hidden.bs.modal', function () {
            _pendingDeleteCallback = null;
            if (document.querySelector('#modalAddProduct.show')) {
                document.body.classList.add('modal-open');
            }
        });

        async function handleExecuteDeleteSubmit(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const modalEl = document.getElementById('modalConfirmDelete');
            const btnConfirm = document.getElementById('btnConfirmDeleteSubmit');
            if (btnConfirm) {
                btnConfirm.disabled = true;
                btnConfirm.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang xóa...';
            }
            try {
                if (typeof _pendingDeleteCallback === 'function') {
                    await _pendingDeleteCallback();
                }
            } catch (err) {
                console.error("Lỗi xóa:", err);
                alert("Đã có lỗi xảy ra khi xóa: " + (err.message || err));
            } finally {
                if (btnConfirm) {
                    btnConfirm.disabled = false;
                }
                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                modalInstance.hide();
            }
            return false;
        }

        // 1. Kích hoạt xóa Sản phẩm Áo (Tab 1)
        function promptDeleteProduct(id, tenSP) {
            showConfirmDeleteDialog({
                title: 'Xác Nhận Ẩn / Xóa Mẫu Áo',
                subjectTitle: 'Ẩn mẫu áo khỏi cửa hàng',
                subjectDesc: `Bạn có chắc muốn xóa/ẩn mẫu áo <strong>${tenSP}</strong> (<span class="text-danger fw-semibold">#SP${id}</span>)?`,
                note: 'Mẫu áo sẽ được ẩn khỏi trang danh sách sản phẩm. Lịch sử phản hồi và đánh giá từ khách hàng vẫn được bảo lưu an toàn.',
                confirmBtnText: 'Xác nhận xóa áo',
                onConfirm: async () => {
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', getCsrfToken());
                    formData.append('id', id);

                    const res = await fetch('/Admin/Product/DeleteProduct', {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });
                    const result = await res.json();
                    if (!res.ok || !result.success) throw new Error(result.message || 'Không thể ẩn sản phẩm.');
                    
                    const tr = document.getElementById(`prodRow_${id}`) || document.querySelector(`button[onclick*="promptDeleteProduct(${id},"]`)?.closest('tr');
                    tr?.remove();
                    showAutoDismissActionMessage('alert-success', result.message || `Đã ẩn mẫu áo '${tenSP}' thành công.`);
                }
            });
        }

        // 2. Kích hoạt xóa Danh mục Áo (Tab 2)
        function promptDeleteCategory(id, tenDM, productCount) {
            const hasProducts = productCount > 0;
            const noteText = hasProducts
                ? `<span class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i> Cảnh báo: Đang có ${productCount} sản phẩm liên kết với danh mục này! Hệ thống sẽ chặn xóa để đảm bảo toàn vẹn dữ liệu.</span>`
                : 'Danh mục sẽ bị xóa hoàn toàn khỏi cơ sở dữ liệu nếu không có sản phẩm liên kết.';

            showConfirmDeleteDialog({
                title: 'Xác Nhận Xóa Danh Mục Áo',
                subjectTitle: `Xóa danh mục #${id}`,
                subjectDesc: `Bạn có chắc muốn xóa danh mục <strong>${tenDM}</strong>?`,
                note: noteText,
                confirmBtnText: 'Xác nhận xóa',
                onConfirm: async () => {
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/Admin/Product/DeleteCategory';
                    
                    const tokenInput = document.createElement('input');
                    tokenInput.type = 'hidden';
                    tokenInput.name = '__RequestVerificationToken';
                    tokenInput.value = getCsrfToken();
                    form.appendChild(tokenInput);

                    const idInput = document.createElement('input');
                    idInput.type = 'hidden';
                    idInput.name = 'id';
                    idInput.value = id;
                    form.appendChild(idInput);

                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }

        // 3. Kích hoạt xóa Biến thể Size/Màu (trong modal Thêm / Sửa áo)
        function promptDeleteVariant(rowId, sku, size, color) {
            const v = window._currentVariants.find(item => String(item.rowId) === String(rowId));
            if (!v) return;

            const maSP = document.getElementById('prodMaSP')?.value.trim() || '';

            if (window._currentVariants.length <= 1) {
                const variantsErr = document.getElementById('variantsSectionError');
                if (variantsErr) {
                    variantsErr.textContent = 'Không thể xóa biến thể cuối cùng! Mỗi sản phẩm bắt buộc phải có ít nhất 1 biến thể (Size & Màu).';
                    variantsErr.style.display = 'block';
                }
                return;
            }

            showConfirmDeleteDialog({
                title: 'Xác Nhận Xóa Biến Thể Size',
                subjectTitle: `Xóa biến thể Size ${size} - Màu ${color}`,
                subjectDesc: `Bạn có chắc muốn xóa biến thể có mã SKU: <strong>${sku || v.sku}</strong>?`,
                note: 'Biến thể này và số lượng tồn kho tương ứng sẽ bị xóa. Tổng tồn kho của áo sẽ tự động tính lại.',
                confirmBtnText: 'Xác nhận xóa size',
                onConfirm: async () => {
                    if (!maSP || !v.maSL) {
                        window._currentVariants = window._currentVariants.filter(item => String(item.rowId) !== String(rowId));
                        if (String(window._editingVariantRowId) === String(rowId)) {
                            closeVariantBoxInEditModal();
                        } else {
                            renderVariantsTable();
                        }
                        showAutoDismissModalMessage('Đã xóa biến thể tạm khỏi danh sách.');
                        return;
                    }

                    const targetMaSL = v.maSL || v.rowId;
                    const formData = new FormData();
                    formData.append('__RequestVerificationToken', getCsrfToken());
                    formData.append('id', targetMaSL);
                    formData.append('formId', targetMaSL);
                    formData.append('maSL', targetMaSL);

                    const res = await fetch(`/Admin/Product/DeleteVariant/${targetMaSL}?id=${targetMaSL}`, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: formData
                    });

                    if (!res.ok) {
                        const errText = await res.text();
                        console.error("DeleteVariant Error:", res.status, errText);
                        throw new Error(`Máy chủ phản hồi mã lỗi ${res.status}.`);
                    }

                    const data = await res.json();
                    if (data.success) {
                        window._productStockModified = true;
                        if (String(window._editingVariantRowId) === String(rowId)) {
                            resetNewVariantBoxInputs();
                            document.getElementById('addVariantInEditBox').style.display = 'none';
                        }
                        // Xóa trực tiếp khỏi RAM và render UI ngay tức thì!
                        window._currentVariants = window._currentVariants.filter(item => String(item.rowId) !== String(rowId) && String(item.maSL) !== String(targetMaSL));
                        renderVariantsTable();
                        showAutoDismissModalMessage(data.message || `Đã xóa biến thể SKU '${v.sku}' thành công!`);
                        loadProductVariantsForEdit(maSP);
                    } else {
                        const alertBox = document.querySelector('#modalAddProduct .form-alert-modal');
                        if (alertBox) {
                            alertBox.textContent = data.message || 'Không thể xóa biến thể.';
                            alertBox.style.display = 'block';
                        }
                        alert(data.message || 'Không thể xóa biến thể.');
                    }
                }
            });
        }

        function showAutoDismissModalMessage(msg) {
            let successBox = document.getElementById('modalVariantSuccessAlert');
            if (!successBox) {
                const modalBody = document.querySelector('#modalAddProduct .modal-body');
                if (modalBody) {
                    successBox = document.createElement('div');
                    successBox.id = 'modalVariantSuccessAlert';
                    successBox.className = 'alert alert-success alert-dismissible fade show py-2 px-3 small fw-semibold mb-3';
                    modalBody.insertBefore(successBox, modalBody.firstChild);
                }
            }
            if (successBox) {
                successBox.innerHTML = `<i class="fa-solid fa-circle-check me-2"></i> ${msg}`;
                successBox.style.display = 'block';
                setTimeout(() => {
                    if (successBox) successBox.style.display = 'none';
                }, 4000);
            }
        }
    </script>
</body>
</html>
