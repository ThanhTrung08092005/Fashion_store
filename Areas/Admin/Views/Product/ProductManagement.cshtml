        function validateStandaloneVariantForm(event, form) {
            clearFormErrors(form);
            let isValid = true;
            let firstInvalid = null;

            function mark(input, msg) {
                setInputError(input, msg);
                isValid = false;
                if (!firstInvalid) firstInvalid = input;
            }

            const kichThuoc = form.querySelector('select[name="KichThuoc"]');
            const mauSac = form.querySelector('select[name="MauSac"]');
            const sku = form.querySelector('input[name="SKU"]');
            const soLuongTon = form.querySelector('input[name="SoLuongTon"]');
            const maSP = form.querySelector('input[name="MaSP"]')?.value.trim() || '';

            const sizeVal = kichThuoc ? kichThuoc.value.trim() : '';
            const colorVal = mauSac ? mauSac.value.trim() : '';

            if (kichThuoc && !sizeVal) {
                mark(kichThuoc, 'Vui lòng chọn kích thước (Size).');
            }
            if (mauSac && !colorVal) {
                mark(mauSac, 'Vui lòng chọn màu sắc.');
            }
            if (sku && sizeVal && colorVal) {
                sku.value = generateAutoSku(maSP, sizeVal, colorVal);
            }
            if (soLuongTon && (soLuongTon.value.trim() === '' || Number(soLuongTon.value) < 0 || !Number.isInteger(Number(soLuongTon.value)) || Number(soLuongTon.value) > 100000)) {
                mark(soLuongTon, 'Số lượng tồn phải là số nguyên từ 0 đến 100.000.');
            }

            if (!isValid) {
                if (event) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                if (firstInvalid) firstInvalid.focus();
            }
            return isValid;
        }

