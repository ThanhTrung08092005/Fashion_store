@model Fashion_store.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng Nhập Admin System - Fashion_store";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --brand-black: #000000;
            --brand-blue-active: #0099ff;
            --brand-border-gray: #e5e7eb;
            --brand-text-muted: #6b7280;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f8fafc;
            color: #111827;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* Main Header */
        .main-header {
            padding: 24px 0;
            border-bottom: 1px solid #f3f4f6;
            background: #ffffff;
        }

        .brand-logo {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #000000;
            text-decoration: none;
            line-height: 1;
            white-space: nowrap;
        }

        /* Signin Box - Dành riêng cho Admin */
        .signin-container {
            max-width: 480px;
            margin: 60px auto 80px;
            padding: 40px 36px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
            border: 1px solid #edf2f7;
        }

        .tab-header {
            display: flex;
            border-bottom: 2px solid #f3f4f6;
            margin-bottom: 30px;
            position: relative;
            justify-content: center;
        }

        .tab-btn {
            text-align: center;
            padding: 12px 0;
            font-weight: 700;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #000000;
            background: none;
            border: none;
            position: relative;
            display: block;
            width: 100%;
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: var(--brand-blue-active);
        }

        .form-floating-custom {
            margin-bottom: 22px;
            position: relative;
        }

        .form-floating-custom input {
            border: none;
            border-bottom: 1px solid #e5e7eb;
            border-radius: 0;
            padding: 11px 0;
            width: 100%;
            font-size: 0.925rem;
            outline: none;
            background: transparent;
            color: #111827;
            transition: border-color 0.2s;
        }

        .form-floating-custom input::placeholder {
            color: #9ca3af;
        }

        .form-floating-custom input:focus {
            border-bottom-color: #000000;
        }

        /* Nút Đăng Nhập rộng 100% bằng độ dài Textbox */
        .btn-brand-submit {
            background-color: #000000;
            color: #ffffff;
            font-weight: 800;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 13px 0;
            border: none;
            border-radius: 2px;
            transition: opacity 0.2s, background-color 0.2s;
            display: block;
            width: 100%;
            text-align: center;
        }

        .btn-brand-submit:hover {
            opacity: 0.9;
            background-color: #1e293b;
            color: #ffffff;
        }

        .validation-summary-valid {
            display: none !important;
        }

        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>

    <!-- Main Header - Căn giữa chữ Fashion_store ADMIN -->
    <header class="main-header text-center">
        <div class="container">
            <a href="/Admin/Account/Login" class="brand-logo d-inline-flex align-items-center justify-content-center gap-2">
                <span>Fashion_store</span>
                <span class="badge bg-dark text-white font-monospace fs-6 px-2.5 py-1 align-middle border ms-1">ADMIN</span>
            </a>
        </div>
    </header>

    <!-- Signin Box - Dành riêng cho Admin (Đã lược bỏ Tab Đăng ký & Quên mật khẩu) -->
    <main class="signin-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success small p-2 mb-3">
                <i class="fa-solid fa-circle-check me-1"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger small p-2 mb-3">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Tab Header Đơn (Chỉ giữ lại ĐĂNG NHẬP, gạch chân xanh dương đúng thiết kế Fashion_store) -->
        <div class="tab-header">
            <div class="tab-btn active">
                ĐĂNG NHẬP
            </div>
        </div>

        <!-- Form Đăng Nhập Admin -->
        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                var errorList = ViewData.ModelState.Values
                    .SelectMany(v => v.Errors)
                    .Select(e => e.ErrorMessage)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .Distinct()
                    .ToList();

                if (errorList.Any())
                {
                    <div class="alert alert-danger p-3 mb-3 border-danger-subtle rounded-2 small fw-semibold">
                        <div class="d-flex align-items-center gap-2 mb-1 text-danger font-weight-bold">
                            <i class="fa-solid fa-circle-exclamation fs-6"></i>
                            <span>Thông báo đăng nhập:</span>
                        </div>
                        <ul class="mb-0 ps-3 text-danger">
                            @foreach (var err in errorList)
                            {
                                <li>@err</li>
                            }
                        </ul>
                    </div>
                }
            }

            <div class="form-floating-custom">
                <input asp-for="TenDangNhap" placeholder="Nhập email hoặc Tên đăng nhập" required autocomplete="username" />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="form-floating-custom mb-4">
                <input asp-for="MatKhau" type="password" placeholder="Mật khẩu" required autocomplete="current-password" />
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <!-- Nút Submit rộng 100% bằng độ dài Textbox (Lược bỏ liên kết Quên mật khẩu) -->
            <div class="mb-3">
                <button type="submit" class="btn btn-brand-submit">
                    ĐĂNG NHẬP
                </button>
            </div>
        </form>
    </main>

</body>
</html>
